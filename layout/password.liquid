<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    <meta name="description" content="{{ shop.description | default: shop.name | escape }}">

    {{ content_for_header }}

    {%- unless settings.font_heading.system? -%}
      {{ settings.font_heading | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}
    {%- unless settings.font_body.system? -%}
      {{ settings.font_body | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {%- endunless -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      {{ settings.font_heading | font_face: font_display: 'swap' }}
      {{ settings.font_body | font_face: font_display: 'swap' }}
      {{ settings.font_subheading | font_face: font_display: 'swap' }}
      {{ settings.font_accent | font_face: font_display: 'swap' }}
      {%- assign subheading_medium = settings.font_subheading | font_modify: 'weight', '500' -%}
      {%- assign accent_semibold = settings.font_accent | font_modify: 'weight', '600' -%}
      {{ subheading_medium | font_face: font_display: 'swap' }}
      {{ accent_semibold | font_face: font_display: 'swap' }}

      :root {
        --color-primary: {{ settings.color_primary }};
        --color-secondary: {{ settings.color_secondary }};
        --color-dark: {{ settings.color_dark }};
        --color-surface: {{ settings.color_surface }};
        --color-background: {{ settings.color_background }};
        --color-text: {{ settings.color_text }};
        --button-primary: {{ settings.button_primary_color }};
        --button-secondary: {{ settings.button_secondary_color }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-subheading: {{ settings.font_subheading.family }}, {{ settings.font_subheading.fallback_families }};
        --font-subheading-weight: {{ settings.font_subheading.weight }};
        --font-subheading-style: {{ settings.font_subheading.style }};
        --font-accent: {{ settings.font_accent.family }}, {{ settings.font_accent.fallback_families }};
        --font-accent-weight: {{ settings.font_accent.weight }};
        --font-accent-style: {{ settings.font_accent.style }};
      }
    </style>
  </head>
  <body class="template-password">
    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
