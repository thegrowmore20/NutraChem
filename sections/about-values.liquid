{%- comment -%}
  About page core-values grid: auto-numbered cards (icon, heading, text).
{%- endcomment -%}

<section
  class="about-values section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="about-values__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-values__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-values__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="about-values__description">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="u-grid about-values__grid">
        {%- for block in section.blocks -%}
          <div class="about-values__card" {{ block.shopify_attributes }}>
            <div class="u-flex u-items-center u-justify-between about-values__card-header">
              <span class="about-values__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- if block.settings.icon != blank -%}
                <span class="about-values__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.heading != blank -%}
              <p class="about-values__card-heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-values__card-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-values__intro {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 48px;
}

.about-values__eyebrow {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin: 0 0 12px;
}

.about-values__heading {
  color: var(--color-primary);
  margin: 0 0 16px;
}

.about-values__description {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
  margin: 0;
}

.about-values__grid {
  grid-template-columns: 1fr;
  gap: 24px;
}

@media screen and (min-width: 600px) {
  .about-values__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (min-width: 990px) {
  .about-values__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.about-values__card {
  padding: 28px 24px;
  border-radius: var(--radius-m);
  background: var(--color-surface);
}

.about-values__card-header {
  margin-bottom: 16px;
}

.about-values__number {
  font-size: 22px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: #c3ccd0;
}

.about-values__icon {
  font-size: 24px;
}

.about-values__card-heading {
  font-size: 17px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 8px;
}

.about-values__card-text {
  font-size: 14px;
  line-height: 1.6;
  color: #55636b;
  margin: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "About values",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What We Stand For" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Core Values" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Six principles that shape every formula, every decision, and every interaction with our community.</p>"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🔬" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Science First" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About values",
      "blocks": [
        { "type": "value", "settings": { "icon": "🔬", "heading": "Science First", "text": "Every formula starts in the lab, not the marketing suite. If it cannot be clinically proven, it does not get made." } },
        { "type": "value", "settings": { "icon": "💎", "heading": "Uncompromised Purity", "text": "No fillers, no artificial fragrances, no greenwashing. Every ingredient earns its place at clinical-grade concentrations." } },
        { "type": "value", "settings": { "icon": "🌿", "heading": "Planet Positive", "text": "Cruelty-free, vegan, and sustainably packaged. We believe premium and responsibility are not mutually exclusive." } },
        { "type": "value", "settings": { "icon": "🤝", "heading": "Radical Transparency", "text": "Full ingredient lists, clinical data, and honest photography. We hide nothing because we have nothing to hide." } },
        { "type": "value", "settings": { "icon": "♾️", "heading": "Continuous Research", "text": "Our lab never stops. We reinvest into dermatological research every year to ensure our formulas stay at the scientific frontier." } },
        { "type": "value", "settings": { "icon": "❤️", "heading": "Community Trust", "text": "We earn trust through results, not promises. Our Glow Guarantee exists because we believe every customer should see a real difference." } }
      ]
    }
  ]
}
{% endschema %}
