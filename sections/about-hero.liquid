{%- comment -%}
  About page hero: eyebrow + heading + description + two buttons, with an
  optional image (falls back to an icon panel when none is set).
{%- endcomment -%}

<section
  class="about-hero section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="u-grid u-items-center about-hero__layout">
      <div class="about-hero__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="about-hero__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h1 class="about-hero__heading h1">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="about-hero__description">{{ section.settings.description }}</div>
        {%- endif -%}
        {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
          <div class="u-flex u-items-center about-hero__actions">
            {%- if section.settings.button_1_label != blank -%}
              <a href="{{ section.settings.button_1_link | default: '#' }}" class="button button--accent">{{ section.settings.button_1_label }}</a>
            {%- endif -%}
            {%- if section.settings.button_2_label != blank -%}
              <a href="{{ section.settings.button_2_link | default: '#' }}" class="u-inline-flex u-items-center about-hero__link">
                {{ section.settings.button_2_label }}
                {% render 'icon', name: 'arrow-right' %}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      <div class="about-hero__media">
        {%- if section.settings.image != blank -%}
          {%- assign hero_alt = section.settings.image.alt | default: section.settings.heading -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 750, 1000', sizes: '(min-width: 750px) 50vw, 100vw', alt: hero_alt }}
        {%- else -%}
          <div class="u-flex u-items-center u-justify-center about-hero__placeholder">{% render 'icon', name: 'sparkle' %}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.about-hero__layout {
  grid-template-columns: 1fr;
  gap: 40px;
}

@media screen and (min-width: 750px) {
  .about-hero__layout {
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }
}

.about-hero__eyebrow {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin: 0 0 14px;
}

.about-hero__heading {
  color: var(--color-primary);
  margin: 0 0 18px;
}

.about-hero__description {
  font-size: 16px;
  line-height: 1.7;
  color: var(--color-text);
  max-width: 46ch;
}

.about-hero__description p {
  margin: 0;
}

.about-hero__actions {
  gap: var(--space-6);
  flex-wrap: wrap;
  margin-top: var(--space-7);
}

.about-hero__link {
  gap: var(--space-2);
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
}

.about-hero__link:hover {
  color: var(--color-secondary);
}

.about-hero__media {
  border-radius: var(--radius-m);
  overflow: hidden;
  background: var(--color-surface);
}

.about-hero__media img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
}

.about-hero__placeholder {
  aspect-ratio: 4 / 3;
  color: var(--color-secondary);
}

.about-hero__placeholder svg {
  width: 64px;
  height: 64px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "About hero",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Science is Our Foundation" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>NutraChem was born from a simple belief: skincare should work. Not just feel good, work. We combine cutting-edge dermatological research with the most potent bioactive ingredients on earth.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Explore Our Products" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Our Science" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    { "name": "About hero" }
  ]
}
{% endschema %}
