{%- liquid
  assign faq_items = product.metafields.custom.faqs.value
  assign faq_count = 0
-%}
{%- capture faq_markup -%}
  {%- for faq in faq_items -%}
    {%- if faq.question.value != blank and faq.answer.value != blank -%}
      {%- assign faq_count = faq_count | plus: 1 -%}
      <div class="product-faq__item" data-faq-item>
        <button type="button" class="product-faq__question" aria-expanded="false" data-faq-trigger>
          <h3 class="product-faq__question-text">
            {% if section.settings.show_numbers %}<span>{{ faq_count }}.</span> {% endif %}{{ faq.question.value | escape }}
          </h3>
          <span class="product-faq__icon" aria-hidden="true">{% render 'icon', name: 'chevron-down' %}</span>
        </button>
        <div class="product-faq__panel">
          <div class="product-faq__panel-inner">
            <div class="product-faq__answer rte">{{ faq.answer | metafield_tag }}</div>
          </div>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if faq_count > 0 -%}
  <section class="product-faq section-padding" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --faq-width: {{ section.settings.content_width }}px;">
    <div class="container">
      <product-faq class="product-faq__content">
        {% render 'section-header', 
          heading: section.settings.heading 
        %}
        {{ faq_markup }}
      </product-faq>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .product-faq__content {
    display: block;
    max-width: var(--faq-width, 1000px);
    margin-inline: auto;
  }

  .product-faq__item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
  }

  .product-faq__item:last-child {
    border-bottom: 0;
  }

  .product-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 52px;
    padding-block: var(--space-3);
    cursor: pointer;
    list-style: none;
    color: var(--color-primary);
    width: 100%;
    text-align: left;
    background: transparent;
    border: none;
    font: inherit;
    padding-inline: 0;
  }

  .product-faq__question:focus-visible {
    outline: 2px solid var(--color-secondary);
    outline-offset: 4px;
  }

  .product-faq__question-text {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    font-family: var(--font-subheading);
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .product-faq__icon {
    display: grid;
    place-items: center;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--button-primary, var(--color-secondary));
    color: #fff;
    transition: transform 200ms ease;
  }

  .product-faq__item[data-faq-open] .product-faq__icon {
    transform: rotate(180deg);
  }

  .product-faq__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.25s ease;
  }

  .product-faq__item[data-faq-open] > .product-faq__panel {
    grid-template-rows: 1fr;
  }

  .product-faq__panel-inner {
    overflow: hidden;
  }

  .product-faq__answer {
    padding: 0 0.5rem var(--space-5) 0.5rem;
    color: var(--color-text);
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  @media screen and (min-width: 750px) {
    .product-faq__question-text {
      font-size: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    .product-faq__question-text {
      font-size: 14px;
    }
  }

  @media screen and (prefers-reduced-motion: reduce) {
    .product-faq__icon {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
class ProductFaq extends HTMLElement {
  constructor() {
    super();
    this.addEventListener('click', this.#onClick.bind(this));
  }

  #onClick(event) {
    const trigger = event.target.closest('[data-faq-trigger]');
    if (!trigger) return;

    const item = trigger.closest('[data-faq-item]');
    if (!item) return;
    
    const willOpen = !item.hasAttribute('data-faq-open');

    for (const other of this.querySelectorAll('[data-faq-item]')) {
      if (other === item) continue;
      other.removeAttribute('data-faq-open');
      other.querySelector('[data-faq-trigger]')?.setAttribute('aria-expanded', 'false');
    }

    item.toggleAttribute('data-faq-open', willOpen);
    trigger.setAttribute('aria-expanded', String(willOpen));
  }
}

if (!customElements.get('product-faq')) {
  customElements.define('product-faq', ProductFaq);
}
{% endjavascript %}

{% schema %}
{
  "name": "Product FAQs",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays the current product's custom.faqs metaobject list using its question and rich-text answer fields. Hidden when no populated FAQs exist."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "FAQs" },
    { "type": "checkbox", "id": "show_numbers", "label": "Show question numbers", "default": true },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 600, "max": 1320, "step": 40, "unit": "px", "default": 1000 },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Product FAQs" }]
}
{% endschema %}
