{%- comment -%}
  "Follow us on YouTube" reel grid, driven by a `youtube_reel` metaobject
  (so merchants manage the reel library once, under Content > Metaobjects,
  and reuse/reorder entries across sections instead of re-typing settings
  per block).

  Requires a metaobject definition with the handle/type `youtube_reel` and
  these fields:
    - video_url  (single line text or URL) - required. Any YouTube link
      works: youtube.com/watch?v=..., youtu.be/..., or youtube.com/shorts/...
    - thumbnail  (file/image)              - optional. Falls back to
      YouTube's own auto-generated thumbnail for the video when not set.
    - title      (single line text)        - optional. Used for alt text
      and the play button's accessible label.

  Clicking a thumbnail opens the video in a modal player (embedded iframe,
  loaded only on click) instead of navigating away.
{%- endcomment -%}

<section
  class="youtube-reels section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --reels-columns-desktop: {{ section.settings.columns_desktop }};"
>
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <h2 class="youtube-reels__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.channel_handle != blank -%}
      {%- if section.settings.channel_url != blank -%}
        <a
          href="{{ section.settings.channel_url }}"
          class="u-flex u-items-center u-justify-center youtube-reels__channel"
          target="_blank" rel="noopener noreferrer"
        >
          {% render 'icon', name: 'youtube' %}
          <span>{{ section.settings.channel_handle }}</span>
          {% render 'icon', name: 'chevron-right' %}
        </a>
      {%- else -%}
        <div class="u-flex u-items-center u-justify-center youtube-reels__channel">
          {% render 'icon', name: 'youtube' %}
          <span>{{ section.settings.channel_handle }}</span>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- assign reels = shop.metaobjects.youtube_reel.values -%}
    {%- if reels.size > 0 -%}
      <youtube-reel-player class="youtube-reels__wrapper">
        <div class="u-grid youtube-reels__grid">
          {%- for reel in reels limit: section.settings.reels_to_show -%}
            {%- liquid
              assign reel_url = reel.video_url.value
              assign video_id = ''
              if reel_url contains 'shorts/'
                assign video_id = reel_url | split: 'shorts/' | last | split: '?' | first
              elsif reel_url contains 'watch?v='
                assign video_id = reel_url | split: 'v=' | last | split: '&' | first
              elsif reel_url contains 'youtu.be/'
                assign video_id = reel_url | split: 'youtu.be/' | last | split: '?' | first
              else
                assign video_id = reel_url
              endif
              assign video_id = video_id | strip
            -%}
            {%- if video_id != blank -%}
              <button
                type="button"
                class="youtube-reels__item"
                data-video-id="{{ video_id }}"
                aria-label="{{ 'sections.youtube_reels.play' | t }}{% if reel.title.value != blank %}: {{ reel.title.value }}{% endif %}"
              >
                {%- if reel.thumbnail.value != blank -%}
                  {{ reel.thumbnail.value | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 375, 500', width: 500, height: 890, alt: reel.title.value | default: '' }}
                {%- else -%}
                  <img src="https://i.ytimg.com/vi/{{ video_id }}/hqdefault.jpg" loading="lazy" width="500" height="375" alt="{{ reel.title.value | default: '' }}">
                {%- endif -%}
                <span class="u-flex u-items-center u-justify-center youtube-reels__play" aria-hidden="true">{% render 'icon', name: 'play' %}</span>
              </button>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="youtube-reels__modal-backdrop" data-video-modal-backdrop hidden></div>
        <div class="youtube-reels__modal" role="dialog" aria-modal="true" aria-label="{{ 'sections.youtube_reels.video_player' | t }}" hidden>
          <button type="button" class="u-inline-flex u-items-center u-justify-center youtube-reels__modal-close" data-video-modal-close aria-label="{{ 'general.accessibility.close' | t }}">
            {% render 'icon', name: 'close' %}
          </button>
          <div class="youtube-reels__modal-frame" data-video-modal-frame></div>
        </div>
      </youtube-reel-player>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.youtube-reels__heading {
  text-align: center;
  font-size: clamp(24px, 20px + 1.2vw, 34px);
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 var(--space-3);
}

.youtube-reels__channel {
  gap: var(--space-2);
  color: var(--color-primary);
  font-weight: 600;
  font-family: var(--font-accent);
  font-size: 14px;
  margin-bottom: var(--space-8);
}

.youtube-reels__channel svg {
  width: 18px;
  height: 18px;
}

.youtube-reels__channel:hover {
  color: var(--color-secondary);
}

.youtube-reels__grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

@media screen and (min-width: 750px) {
  .youtube-reels__grid {
    grid-template-columns: repeat(var(--reels-columns-desktop, 4), minmax(0, 1fr));
    gap: var(--space-5);
  }
}

.youtube-reels__item {
  position: relative;
  display: block;
  width: 100%;
  aspect-ratio: 9 / 16;
  border: none;
  padding: 0;
  border-radius: var(--radius-m);
  overflow: hidden;
  cursor: pointer;
  background: var(--color-primary);
}

.youtube-reels__item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.youtube-reels__item:hover img {
  transform: scale(1.04);
}

.youtube-reels__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 46px;
  height: 32px;
  border-radius: var(--radius-s);
  background: #ff0000;
  color: #fff;
}

.youtube-reels__play svg {
  width: 16px;
  height: 16px;
  margin-left: 2px;
}

.youtube-reels__modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 10020;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.youtube-reels__modal-backdrop.is-open {
  opacity: 1;
}

.youtube-reels__modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.96);
  z-index: 10021;
  width: 100%;
  max-width: 420px;
  padding: 0 var(--space-4);
  opacity: 0;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

.youtube-reels__modal.is-open {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.youtube-reels__modal-frame {
  position: relative;
  width: 100%;
  aspect-ratio: 9 / 16;
  max-height: 85vh;
  margin: 0 auto;
  border-radius: var(--radius-m);
  overflow: hidden;
  background: #000;
}

.youtube-reels__modal-frame iframe {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.youtube-reels__modal-close {
  min-width: 44px;
  min-height: 44px;
  margin-left: auto;
  margin-bottom: var(--space-1);
  background: none;
  border: none;
  cursor: pointer;
  color: #fff;
}

body.video-modal-open {
  overflow: hidden;
}
{% endstylesheet %}

{% javascript %}
class YoutubeReelPlayer extends HTMLElement {
  #backdrop
  #modal
  #closeButton
  #frame
  #lastFocused

  constructor() {
    super()
    this.#backdrop = this.querySelector('[data-video-modal-backdrop]')
    this.#modal = this.querySelector('.youtube-reels__modal')
    this.#closeButton = this.querySelector('[data-video-modal-close]')
    this.#frame = this.querySelector('[data-video-modal-frame]')
    if (!this.#backdrop || !this.#modal || !this.#frame) return

    this.addEventListener('click', (event) => this.#onClick(event))
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
  }

  #onClick(event) {
    const trigger = event.target.closest('[data-video-id]')
    if (trigger) {
      this.#open(trigger.dataset.videoId, trigger)
      return
    }
    if (event.target.closest('[data-video-modal-close]') || event.target === this.#backdrop) {
      this.#close()
    }
  }

  #onKeydown(event) {
    if (event.key === 'Escape' && this.#modal.classList.contains('is-open')) this.#close()
  }

  #open(videoId, trigger) {
    this.#lastFocused = trigger
    const iframe = document.createElement('iframe')
    iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0&playsinline=1`
    iframe.allow = 'autoplay; encrypted-media; picture-in-picture'
    iframe.allowFullscreen = true
    iframe.title = 'YouTube video player'
    this.#frame.innerHTML = ''
    this.#frame.appendChild(iframe)

    this.#backdrop.hidden = false
    this.#modal.hidden = false
    requestAnimationFrame(() => {
      this.#backdrop.classList.add('is-open')
      this.#modal.classList.add('is-open')
    })
    document.body.classList.add('video-modal-open')
    this.#closeButton.focus()
  }

  #close() {
    this.#backdrop.classList.remove('is-open')
    this.#modal.classList.remove('is-open')
    document.body.classList.remove('video-modal-open')
    window.setTimeout(() => {
      this.#backdrop.hidden = true
      this.#modal.hidden = true
      this.#frame.innerHTML = ''
    }, 250)
    this.#lastFocused?.focus()
  }
}

if (!customElements.get('youtube-reel-player')) {
  customElements.define('youtube-reel-player', YoutubeReelPlayer)
}
{% endjavascript %}

{% schema %}
{
  "name": "YouTube reels",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow Us on YouTube" },
    { "type": "text", "id": "channel_handle", "label": "Channel handle", "info": "e.g. @yourbrand - leave blank to hide the channel link." },
    { "type": "url", "id": "channel_url", "label": "Channel URL" },
    {
      "type": "range",
      "id": "reels_to_show",
      "label": "Reels to show",
      "min": 1,
      "max": 20,
      "step": 1,
      "default": 8,
      "info": "Add and manage reels under Content > Metaobjects (fields: video_url, and optionally thumbnail + title) - every entry shows here automatically, up to this limit."
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [
    { "name": "YouTube reels" }
  ]
}
{% endschema %}
