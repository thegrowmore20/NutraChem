            "button_label": "Shop Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% javascript %}
class HeroSlideshow extends HTMLElement {
  #track
  #slides
  #dots
  #prevBtn
  #nextBtn
  #index = 0
  #autoplayTimer
  #autoplayDelay
  #autoplayEnabled
  #reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  #pointerStartX

  connectedCallback() {
    this.#track = this.querySelector('[data-slideshow-track]')
    this.#slides = Array.from(this.querySelectorAll('[data-slideshow-slide]'))
    this.#dots = Array.from(this.querySelectorAll('.hero-slideshow__dot'))
    this.#prevBtn = this.querySelector('.hero-slideshow__arrow--prev')
    this.#nextBtn = this.querySelector('.hero-slideshow__arrow--next')
    this.#autoplayDelay = Number(this.dataset.autoplaySpeed) || 5000
    this.#autoplayEnabled = this.dataset.autoplay === 'true' && this.#slides.length > 1 && !this.#reducedMotion

    if (this.#slides.length < 2) return

    this.#prevBtn?.addEventListener('click', () => this.#userGoTo(this.#index - 1))
    this.#nextBtn?.addEventListener('click', () => this.#userGoTo(this.#index + 1))
    for (const dot of this.#dots) {
      dot.addEventListener('click', () => this.#userGoTo(Number(dot.dataset.index)))
    }

    this.addEventListener('pointerdown', (event) => (this.#pointerStartX = event.clientX))
    this.addEventListener('pointerup', (event) => this.#onSwipeEnd(event))
    this.addEventListener('mouseenter', () => this.#stopAutoplay())
    this.addEventListener('mouseleave', () => this.#startAutoplay())
    this.addEventListener('focusin', () => this.#stopAutoplay())
    this.addEventListener('focusout', () => this.#startAutoplay())
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) this.#stopAutoplay()
      else this.#startAutoplay()
    })

    this.#startAutoplay()
  }

  disconnectedCallback() {
    this.#stopAutoplay()
  }

  #onSwipeEnd(event) {
    if (this.#pointerStartX === undefined) return
    const deltaX = event.clientX - this.#pointerStartX
    this.#pointerStartX = undefined
    if (Math.abs(deltaX) < 40) return
    this.#userGoTo(deltaX < 0 ? this.#index + 1 : this.#index - 1)
  }

  #userGoTo(index) {
    this.#goTo(index)
    this.#stopAutoplay()
    this.#startAutoplay()
  }

  #goTo(index) {
    const nextIndex = (index + this.#slides.length) % this.#slides.length
    if (nextIndex === this.#index) return

    const current = this.#slides[this.#index]
    const next = this.#slides[nextIndex]
    current.classList.remove('is-active')
    current.inert = true
    next.classList.add('is-active')
    next.inert = false

    this.#dots[this.#index]?.classList.remove('is-active')
    this.#dots[nextIndex]?.classList.add('is-active')

    this.#index = nextIndex
  }

  #startAutoplay() {
    if (!this.#autoplayEnabled || this.#autoplayTimer) return
    this.#autoplayTimer = window.setInterval(() => this.#goTo(this.#index + 1), this.#autoplayDelay)
  }

  #stopAutoplay() {
    window.clearInterval(this.#autoplayTimer)
    this.#autoplayTimer = undefined
  }
}

if (!customElements.get('hero-slideshow-el')) {
  customElements.define('hero-slideshow-el', HeroSlideshow)
}
{% endjavascript %}
