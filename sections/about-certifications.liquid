{%- comment -%}
  About page certifications: badge cards (icon, heading, text) plus a
  compliance list of regulation/standard names.

  Accepts two block types: "badge" and "compliance_item".
{%- endcomment -%}

<section
  class="about-certifications section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {% render 'section-header', 
      subheading: section.settings.eyebrow, 
      heading: section.settings.heading, 
      text: section.settings.description 
    %}

    {%- assign badges = section.blocks | where: 'type', 'badge' -%}
    {%- if badges.size > 0 -%}
      <div class="u-grid about-certifications__grid">
        {%- for block in badges -%}
          <div class="about-certifications__badge" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <span class="u-inline-flex u-items-center u-justify-center about-certifications__icon" aria-hidden="true">{{ block.settings.icon }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <p class="about-certifications__badge-heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-certifications__badge-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign compliance_items = section.blocks | where: 'type', 'compliance_item' -%}
    {%- if compliance_items.size > 0 -%}
      <div class="about-certifications__compliance">
        {%- if section.settings.compliance_label != blank -%}
          <p class="about-certifications__compliance-label">{{ section.settings.compliance_label }}</p>
        {%- endif -%}
        <ul class="u-flex u-justify-center about-certifications__compliance-list" role="list">
          {%- for block in compliance_items -%}
            <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-certifications__intro {
  text-align: center;
  max-width: 640px;
  margin: 0 auto 48px;
}

.about-certifications__eyebrow {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin: 0 0 12px;
}

.about-certifications__heading {
  color: var(--color-primary);
  margin: 0 0 16px;
}

.about-certifications__description {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
  margin: 0;
}

.about-certifications__grid {
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-bottom: 40px;
}

@media screen and (min-width: 750px) {
  .about-certifications__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.about-certifications__badge {
  text-align: center;
  padding: 24px 16px;
  border-radius: var(--radius-m);
  background: var(--color-surface);
}

.about-certifications__icon {
  width: 48px;
  height: 48px;
  font-size: 22px;
  border-radius: 50%;
  background: var(--color-background);
  margin-bottom: 12px;
}

.about-certifications__badge-heading {
  font-size: 14px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 6px;
}

.about-certifications__badge-text {
  font-size: 12px;
  line-height: 1.5;
  color: #55636b;
  margin: 0;
}

.about-certifications__compliance {
  text-align: center;
}

.about-certifications__compliance-label {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #7c8a90;
  margin: 0 0 16px;
}

.about-certifications__compliance-list {
  flex-wrap: wrap;
  gap: 10px 24px;
  list-style: none;
  margin: 0;
  padding: 0;
  font-size: 13px;
  color: var(--color-primary);
}
{% endstylesheet %}

{% schema %}
{
  "name": "About certifications",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Certifications & Standards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Held to the Highest Standard" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every product meets or exceeds the strictest international safety, efficacy, and environmental standards.</p>"
    },
    { "type": "text", "id": "compliance_label", "label": "Compliance list label", "default": "Compliant With" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🐰" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Cruelty-Free" },
        { "type": "text", "id": "text", "label": "Text", "default": "No animal testing at any stage." }
      ]
    },
    {
      "type": "compliance_item",
      "name": "Compliance item",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "EU Cosmetics Regulation 1223/2009" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About certifications",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🐰", "heading": "Cruelty-Free", "text": "Certified by Leaping Bunny. No animal testing at any stage." } },
        { "type": "badge", "settings": { "icon": "🌿", "heading": "Vegan", "text": "Certified by The Vegan Society. Zero animal-derived ingredients." } },
        { "type": "badge", "settings": { "icon": "🔬", "heading": "Clinically Proven", "text": "Clinically tested formula. Proven results for visible skin improvement." } },
        { "type": "badge", "settings": { "icon": "🏥", "heading": "Dermatologist Tested", "text": "Signed off by board-certified dermatologists before every release." } },
        { "type": "compliance_item", "settings": { "text": "EU Cosmetics Regulation 1223/2009" } },
        { "type": "compliance_item", "settings": { "text": "FDA 21 CFR Cosmetics" } },
        { "type": "compliance_item", "settings": { "text": "ISO 22716 GMP" } },
        { "type": "compliance_item", "settings": { "text": "Leaping Bunny" } },
        { "type": "compliance_item", "settings": { "text": "The Vegan Society" } }
      ]
    }
  ]
}
{% endschema %}
