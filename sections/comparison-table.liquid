<div class="comparison-section section-padding" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container" style="max-width: {{ section.settings.content_max_width }}px;">
    {% render 'section-header', 
      heading: section.settings.heading, 
      subheading: section.settings.subheading 
    %}

    <div class="comparison-table-wrapper">
      <div class="comparison-table-scroll">
        <table class="comparison-table">
          <thead>
            <tr>
              <th class="comparison-th-feature">{{ section.settings.header_1 }}</th>
              <th class="comparison-feature-text-th-highlight">
                <span>{{ section.settings.header_2 }}</span>
              </th>
              <th class="comparison-th-regular">
                <span>{{ section.settings.header_3 }}</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <td>
                  <div class="comparison-td-feature">
                    <div class="comparison-icon-wrap">
                      {%- if block.settings.icon_image != blank -%}
                        {{ block.settings.icon_image | image_url: width: 80 | image_tag: loading: 'lazy' }}
                      {%- elsif block.settings.icon_svg != blank -%}
                        {{ block.settings.icon_svg }}
                      {%- else -%}
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
                      {%- endif -%}
                    </div>
                    <span class="comparison-feature-text">{{ block.settings.text }}</span>
                  </div>
                </td>
                <td class="comparison-td-highlight">
                  {%- if section.settings.icon_check != blank -%}
                    {{ section.settings.icon_check | image_url: width: 56 | image_tag: class: 'comparison-status-icon', loading: 'lazy' }}
                  {%- else -%}
                    <svg class="comparison-status-icon comparison-status-icon--check" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                  {%- endif -%}
                </td>
                <td class="comparison-td-regular">
                  {%- if section.settings.icon_cross != blank -%}
                    {{ section.settings.icon_cross | image_url: width: 48 | image_tag: class: 'comparison-status-icon comparison-status-icon--cross', loading: 'lazy' }}
                  {%- else -%}
                    <svg class="comparison-status-icon comparison-status-icon--cross comparison-status-icon--cross-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  {%- endif -%}
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</div>
{%- stylesheet -%}

.comparison-table-wrapper {
  max-width: 1024px;
  margin: 0 auto;
  background-color: var(--color-background);
  border-radius: 16px;
  border: 1px solid var(--color-surface);
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  overflow: hidden;
  position: relative;
}

.comparison-table-scroll {
  overflow-x: auto;
  padding-bottom: var(--space-2);
}

.comparison-table-scroll::-webkit-scrollbar {
  height: 4px;
}
.comparison-table-scroll::-webkit-scrollbar-track {
  background: var(--color-surface, #f1f5f9);
  border-radius: 4px;
}
.comparison-table-scroll::-webkit-scrollbar-thumb {
  background: var(--color-text, #cbd5e1);
  border-radius: 4px;
}
.comparison-table-scroll::-webkit-scrollbar-thumb:hover {
  background: var(--color-primary, #94a3b8);
}

@media screen and (min-width: 640px) {
  .comparison-table-scroll {
    padding-bottom: 0;
  }
}

.comparison-table {
  width: 100%;
  min-width: 700px;
  text-align: left;
  border-collapse: collapse;
}

.comparison-table th {
  padding: var(--space-6) var(--space-6);
  border-bottom: 1px solid var(--color-surface, #e2e8f0);
}

.comparison-table td {
  padding: var(--space-5) var(--space-6);
  border-bottom: 1px solid var(--color-surface, #f1f5f9);
}

@media screen and (min-width: 640px) {
  .comparison-table th, .comparison-table td {
    padding-left: var(--space-8);
    padding-right: var(--space-8);
  }
}

.comparison-th-feature {
  text-transform: uppercase;
  letter-spacing: 0.15em;
  font-weight: 600;
  color: var(--color-text, #94a3b8);
  width: 40%;
}

.comparison-th-highlight {
  text-align: center;
  width: 30%;
  background-color: var(--color-surface, #F5F7F6);
  border-left: 1px solid var(--color-background, #e2e8f0);
  border-right: 1px solid var(--color-background, #e2e8f0);
  position: relative;
}

.comparison-th-highlight::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  background-color: var(--color-primary, #2C3E35);
}

.comparison-th-highlight span {
  display: block;
  font-family: var(--font-heading);
  color: var(--color-primary, #1E2B25);
  font-weight: 700;
  font-size: 18px;
  margin-bottom: 2px;
}

@media screen and (min-width: 640px) {
  .comparison-th-highlight span {
    font-size: 20px;
  }
}

.comparison-th-regular {
  text-align: center;
  width: 30%;
}

.comparison-th-regular span {
  font-family: var(--font-heading);
  color: var(--color-text, #94a3b8);
  font-weight: 500;
  font-size: 16px;
}

@media screen and (min-width: 640px) {
  .comparison-th-regular span {
    font-size: 18px;
  }
}

.comparison-table tbody tr {
  transition: background-color 0.2s ease;
}

.comparison-table tbody tr:last-child td {
  border-bottom: none;
}

.comparison-table tbody tr:hover td {
  background-color: var(--color-surface, #FAFAFA);
}

.comparison-td-highlight {
  background-color: var(--color-surface, #F5F7F6);
  border-left: 1px solid var(--color-background, #e2e8f0);
  border-right: 1px solid var(--color-background, #e2e8f0);
  text-align: center;
  transition: background-color 0.3s ease;
}

.comparison-table tbody tr:hover .comparison-td-highlight {
  background-color: var(--color-background, #F0F4F2);
}

.comparison-td-feature {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.comparison-icon-wrap {
  flex-shrink: 0;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-color: var(--color-background, #f8fafc);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text, #64748b);
  border: 1px solid var(--color-surface, #f1f5f9);
}

.comparison-icon-wrap img {
  width: 24px;
  height: 24px;
  object-fit: contain;
}

.comparison-icon-wrap svg {
  width: 20px;
  height: 20px;
}

.comparison-feature-text {
  font-size: 14px;
  font-weight: 500;
  color: var(--color-text, #334155);
}

.comparison-td-regular {
  text-align: center;
}

.comparison-status-icon {
  width: 28px;
  height: 28px;
  margin: 0 auto;
  display: block;
  object-fit: contain;
}

.comparison-status-icon--cross {
  width: 24px;
  height: 24px;
}

.comparison-status-icon--check {
  color: var(--color-primary, #4A8B63);
}

.comparison-status-icon--cross-svg {
  color: var(--color-text, #cbd5e1);
}
@media screen and (max-width: 992px) {
  .comparison-feature-text {
    font-size: 14px;
  }

  .comparison-icon-wrap{
    width: 2rem;
    height: 2rem;
  }

  .comparison-td-feature {
    gap: 0.5rem;
  }

  .comparison-table th,
  .comparison-table td{
    padding: 1rem;
  }

}
{%- endstylesheet -%}
{% schema %}
