{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

.image-gallery__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: {{ section.settings.image_space | divided_by: 2 }}px;
}

@media screen and (min-width: 750px) {
  .image-gallery__grid {
    /* Auto-fit creates columns based on available space. 
       Adjust 250px depending on how many per row you prefer minimum. */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: {{ section.settings.image_space }}px;
  }
}

.image-gallery__item {
  display: block;
  position: relative;
  overflow: hidden;
  border-radius: {{ section.settings.border_radius }}px;
  text-decoration: none;
  {%- if section.settings.enable_border -%}
    border: 1px solid {{ section.settings.border_color }};
  {%- endif -%}
}

.image-gallery__media {
  position: relative;
  width: 100%;
}

.image-gallery__media--square { padding-bottom: 100%; }
.image-gallery__media--portrait { padding-bottom: 125%; }
.image-gallery__media--landscape { padding-bottom: 66.66%; }

.image-gallery__media img,
.image-gallery__media svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.image-gallery__media svg {
  background-color: var(--color-surface, #f4f6f7);
  color: var(--color-text, #aeb4b8);
  padding: 30px;
}

/* Hover effect on images */
a.image-gallery__item:hover .image-gallery__media img {
  transform: scale(1.05);
}

.image-gallery__media--adapt img,
.image-gallery__media--adapt svg {
  position: static;
  width: 100%;
  height: auto;
  display: block;
}

.image-gallery__media--adapt svg {
  aspect-ratio: 1; /* Fallback for empty block in adapt mode */
}
{%- endstyle -%}

<div class="image-gallery section-{{ section.id }}-padding">
  <div class="container" style="max-width: {{ section.settings.content_max_width }}px; margin: 0 auto;">
    {% render 'section-header', 
      heading: section.settings.heading, 
      subheading: section.settings.subheading,
      text: section.settings.text
    %}

    <div class="image-gallery__grid">
      {%- for block in section.blocks -%}
        <{% if block.settings.link != blank %}a href="{{ block.settings.link }}"{% else %}div{% endif %} class="image-gallery__item" {{ block.shopify_attributes }}>
          <div class="image-gallery__media image-gallery__media--{{ section.settings.aspect_ratio }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </{% if block.settings.link != blank %}a{% else %}div{% endif %}>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Gallery",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Gallery"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share moments, products, or inspiration.</p>"
    },
    {
      "type": "range",
      "id": "image_space",
      "label": "Space between images",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "landscape", "label": "Landscape (3:2)" }
      ],
      "default": "square"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "enable_border",
      "label": "Enable image border",
      "default": false
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e2e6e8"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 600,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
