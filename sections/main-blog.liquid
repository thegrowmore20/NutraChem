{%- comment -%}
  Blog listing page. Inspired by Dawn's main-blog.liquid structurally
  (breadcrumb, heading, article grid, pagination) but rebuilt on this theme's
  own conventions: .container/.section-padding, plain-string schema names,
  and top-level checkbox settings instead of Dawn's block-based toggles.
{%- endcomment -%}

<section
  class="blog-listing section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --blog-columns-desktop: {{ section.settings.columns_desktop }};"
>
  <div class="container">
    <nav class="blog-listing__breadcrumb" aria-label="breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a></li>
        <li aria-current="page">{{ blog.title }}</li>
      </ol>
    </nav>

    <h1 class="blog-listing__title h2">{{ blog.title }}</h1>

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size > 0 -%}
        <h2 class="visually-hidden">{{ 'blogs.general.articles_heading' | t }}</h2>
        <div class="u-grid blog-listing__grid">
          {%- for article in blog.articles -%}
            {%- render 'article-card',
              article: article,
              blog: blog,
              show_image: section.settings.show_image,
              show_excerpt: section.settings.show_excerpt,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_comments: section.settings.show_comments
            -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.pagination_mode == 'load_more' and paginate.next -%}
          <div class="u-flex u-items-center u-justify-center load-more" data-blog-load-more-container>
            <a href="{{ paginate.next.url }}" class="u-inline-flex button hero__button load-more__button" data-blog-load-more>{{ 'general.pagination.load_more' | t }}</a>
          </div>
        {%- elsif section.settings.pagination_mode == 'pagination' and paginate.pages > 1 -%}
          <nav class="u-flex u-items-center u-justify-center pagination" aria-label="pagination">
            {%- for part in paginate.parts -%}<a href="{{ part.url }}" class="pagination__link{% unless part.is_link %} pagination__link--current{% endunless %}">{{ part.title }}</a>{%- endfor -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        <p class="blog-listing__empty">{{ 'blogs.general.no_articles' | t }}</p>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% stylesheet %}
.blog-listing__breadcrumb ol {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  padding: 0 0 15px;
  font-size: 14px;
  color: var(--color-text-muted);
  list-style: none;
}

.blog-listing__breadcrumb li {
  display: flex;
  align-items: center;
  gap: 6px;
}

.blog-listing__breadcrumb li:not(:last-child)::after {
  content: '/';
  color: var(--color-text-muted);
}

.blog-listing__breadcrumb a {
  color: var(--color-text-muted);
}

.blog-listing__breadcrumb a:hover {
  color: var(--color-secondary);
}

.blog-listing__breadcrumb li[aria-current='page'] {
  color: var(--color-primary);
}

@media screen and (max-width: 749px) {
  .blog-listing__breadcrumb ol {
    font-size: 12px;
  }
}

.blog-listing__title {
  color: var(--color-primary);
  margin: 0 0 var(--space-8);
}

.blog-listing__grid {
  grid-template-columns: 1fr;
  gap: var(--space-3);
}

@media screen and (min-width: 750px) {
  .blog-listing__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }
}

@media screen and (min-width: 990px) {
  .blog-listing__grid {
    grid-template-columns: repeat(var(--blog-columns-desktop, 3), minmax(0, 1fr));
  }
}

.blog-listing-card {
  display: flex;
  flex-direction: column;
  transform-origin: center;
  transition: transform 0.25s ease;
  backface-visibility: hidden;
}

.blog-listing-card:hover {
  transform: translateY(-5px);
}

.blog-listing-card__media {
  display: block;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  border-radius: var(--radius-m);
  background: var(--color-surface);
}

.blog-listing-card__media img,
.blog-listing-card__media svg {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.blog-listing-card__body {
  padding-top: var(--space-4);
}

.blog-listing-card__meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin: 0 0 var(--space-2);
}

.blog-listing-card__title {
  font-size: 18px;
  font-weight: 600;
  font-family: var(--font-accent);
  line-height: 1.35;
  margin: 0 0 10px;
}

.blog-listing-card__title a {
  color: var(--color-primary);
}

.blog-listing-card__title a:hover {
  color: var(--color-secondary);
}

.blog-listing-card__excerpt {
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-muted);
  margin: 0 0 14px;
}

.blog-listing-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  flex-wrap: wrap;
}

.blog-listing-card__link {
  font-size: 14px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-secondary-a11y, var(--color-secondary));
  text-decoration: underline;
}

.blog-listing-card__comments {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  color: var(--color-text-muted);
}

.blog-listing-card__comments svg {
  width: 15px;
  height: 15px;
}

.blog-listing__empty {
  color: var(--color-primary);
  padding: 40px 0;
}

.load-more {
  gap: var(--space-2);
  margin-top: 40px;
}

.load-more__button {
  min-width: 142px;
  color: #fff;
}

.load-more__button:hover {
  color: #fff;
}

.pagination {
  gap: var(--space-2);
  margin-top: 40px;
}

.pagination__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  height: 36px;
  color: var(--color-primary);
}

.pagination__link--current {
  background: var(--color-secondary);
  color: #fff;
}
{% endstylesheet %}

{% javascript %}
document.querySelectorAll('[data-blog-load-more]').forEach((link) => {
  link.addEventListener('click', async (event) => {
    event.preventDefault()
    const container = link.closest('[data-blog-load-more-container]')
    const grid = link.closest('.blog-listing').querySelector('.blog-listing__grid')
    if (!container || !grid) return
    link.classList.add('is-loading')
    link.setAttribute('aria-busy', 'true')
    try {
      const separator = link.href.includes('?') ? '&' : '?'
      const response = await fetch(`${link.href}${separator}section_id={{ section.id }}`)
      const doc = new DOMParser().parseFromString(await response.text(), 'text/html')
      const nextGrid = doc.querySelector('.blog-listing__grid')
      if (nextGrid) grid.insertAdjacentHTML('beforeend', nextGrid.innerHTML)
      const nextLink = doc.querySelector('[data-blog-load-more]')
      if (nextLink) link.href = nextLink.href
      else container.remove()
    } finally {
      link.classList.remove('is-loading')
      link.removeAttribute('aria-busy')
    }
  })
})
{% endjavascript %}

{% schema %}
{
  "name": "Blog",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "select",
      "id": "pagination_mode",
      "label": "Blog navigation",
      "options": [
        { "value": "load_more", "label": "Load more" },
        { "value": "pagination", "label": "Numbered pagination" }
      ],
      "default": "load_more"
    },
    {
      "type": "header",
      "content": "Article card"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comment count",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ]
}
{% endschema %}
