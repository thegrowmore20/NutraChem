{% comment %}
  Trusted Partners / Logo Bar section
  - Fully standalone: no theme CSS classes, snippets or JS libraries required.
  - Fonts intentionally use `inherit` so headings/text pick up whatever font-family
    the theme already sets on <body> — no fonts are hardcoded here.
  - Animation is pure CSS (infinite marquee), so there is zero JS payload.
  - All spacing/typography is controlled separately for mobile vs desktop via
    the theme editor, using CSS custom properties swapped at a 750px breakpoint.
{% endcomment %}

<div
  id="TrustedPartners-{{ section.id }}"
  class="tp-section{% if section.settings.grayscale_logos %} tp-grayscale{% endif %}"
  style="background-color: {{ section.settings.background_color }};"
>
  <div class="tp-inner">

    {%- if section.settings.subheading != blank or section.settings.heading != blank -%}
      <div class="tp-header tp-align-{{ section.settings.content_alignment }}">
        {%- if section.settings.subheading != blank -%}
          <p class="tp-subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="tp-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_divider -%}
      <div class="tp-divider"></div>
    {%- endif -%}

    <div class="tp-track-wrap">
      <div
        class="tp-track{% if section.settings.enable_animation and section.blocks.size > 0 %} is-marquee{% if section.settings.animation_direction == 'right' %} direction-reverse{% endif %}{% if section.settings.pause_on_hover %} pause-on-hover{% endif %}{% else %} is-static{% endif %}"
      >
        {%- for block in section.blocks -%}
          <div class="tp-logo-item" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="tp-logo-link">{%- endif -%}
            {%- if block.settings.image -%}
              {{ block.settings.image
                | image_url: width: 450
                | image_tag:
                  loading: 'lazy',
                  widths: '150, 300, 450',
                  sizes: '200px',
                  class: 'tp-logo-img',
                  alt: block.settings.image.alt | default: block.settings.name | escape
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'tp-logo-img tp-logo-placeholder' }}
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
            {%- if section.settings.show_names and block.settings.name != blank -%}
              <span class="tp-logo-name">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.enable_animation and section.blocks.size > 0 -%}
          {%- comment -%} Duplicate set (aria-hidden) so the marquee loops seamlessly {%- endcomment -%}
          {%- for block in section.blocks -%}
            <div class="tp-logo-item" aria-hidden="true">
              {%- if block.settings.link != blank -%}<span class="tp-logo-link" tabindex="-1">{%- endif -%}
              {%- if block.settings.image -%}
                {{ block.settings.image
                  | image_url: width: 450
                  | image_tag: loading: 'lazy', widths: '150, 300, 450', sizes: '200px', class: 'tp-logo-img', alt: ''
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'tp-logo-img tp-logo-placeholder' }}
              {%- endif -%}
              {%- if block.settings.link != blank -%}</span>{%- endif -%}
              {%- if section.settings.show_names and block.settings.name != blank -%}
                <span class="tp-logo-name">{{ block.settings.name | escape }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

  </div>
</div>

{% style %}
  #TrustedPartners-{{ section.id }} {
    --tp-pad-top: {{ section.settings.padding_top_mobile }}px;
    --tp-pad-bottom: {{ section.settings.padding_bottom_mobile }}px;
    --tp-header-gap: {{ section.settings.heading_spacing_mobile }}px;
    --tp-subheading-size: {{ section.settings.subheading_size_mobile }}px;
    --tp-heading-size: {{ section.settings.heading_size_mobile }}px;
    --tp-logo-height: {{ section.settings.logo_height_mobile }}px;
    --tp-gap: {{ section.settings.logo_gap_mobile }}px;
    --tp-duration: {{ section.settings.animation_speed }}s;

    box-sizing: border-box;
    width: 100%;
    color: {{ section.settings.heading_color }};
  }

  @media screen and (min-width: 750px) {
    #TrustedPartners-{{ section.id }} {
      --tp-pad-top: {{ section.settings.padding_top_desktop }}px;
      --tp-pad-bottom: {{ section.settings.padding_bottom_desktop }}px;
      --tp-header-gap: {{ section.settings.heading_spacing_desktop }}px;
      --tp-subheading-size: {{ section.settings.subheading_size_desktop }}px;
      --tp-heading-size: {{ section.settings.heading_size_desktop }}px;
      --tp-logo-height: {{ section.settings.logo_height_desktop }}px;
      --tp-gap: {{ section.settings.logo_gap_desktop }}px;
    }
  }

  #TrustedPartners-{{ section.id }} * {
    box-sizing: border-box;
  }

  #TrustedPartners-{{ section.id }} .tp-inner {
    width: 100%;
    padding-top: var(--tp-pad-top);
    padding-bottom: var(--tp-pad-bottom);
    padding-left: clamp(16px, 4vw, 48px);
    padding-right: clamp(16px, 4vw, 48px);
  }

  #TrustedPartners-{{ section.id }} .tp-header {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: var(--tp-header-gap);
  }

  #TrustedPartners-{{ section.id }} .tp-align-center { align-items: center; text-align: center; }
  #TrustedPartners-{{ section.id }} .tp-align-left { align-items: flex-start; text-align: left; }

  #TrustedPartners-{{ section.id }} .tp-subheading {
    margin: 0;
    font-family: inherit;
    font-size: var(--tp-subheading-size);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: {{ section.settings.subheading_color }};
  }

  #TrustedPartners-{{ section.id }} .tp-heading {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 500;
    font-size: var(--tp-heading-size);
    line-height: 1.2;
    color: {{ section.settings.heading_color }};
  }

  #TrustedPartners-{{ section.id }} .tp-divider {
    width: 100%;
    height: 1px;
    background-color: {{ section.settings.border_color }};
    margin-bottom: var(--tp-header-gap);
  }

  #TrustedPartners-{{ section.id }} .tp-track-wrap {
    width: 100%;
    overflow: hidden;
    {% if section.settings.show_top_border %}border-top: 1px solid {{ section.settings.border_color }};{% endif %}
    {% if section.settings.show_bottom_border %}border-bottom: 1px solid {{ section.settings.border_color }};{% endif %}
    padding-top: calc(var(--tp-header-gap) / 2);
    padding-bottom: calc(var(--tp-header-gap) / 2);
  }

  #TrustedPartners-{{ section.id }} .tp-track {
    display: flex;
    align-items: center;
    gap: var(--tp-gap);
  }

  #TrustedPartners-{{ section.id }} .tp-track.is-static {
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
  }

  #TrustedPartners-{{ section.id }} .tp-track.is-marquee {
    width: max-content;
    animation: tp-scroll-{{ section.id }} var(--tp-duration) linear infinite;
  }

  #TrustedPartners-{{ section.id }} .tp-track.is-marquee.direction-reverse {
    animation-direction: reverse;
  }

  #TrustedPartners-{{ section.id }} .tp-track.is-marquee.pause-on-hover:hover,
  #TrustedPartners-{{ section.id }} .tp-track.is-marquee.pause-on-hover:focus-within {
    animation-play-state: paused;
  }

  @keyframes tp-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  #TrustedPartners-{{ section.id }} .tp-logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  #TrustedPartners-{{ section.id }} .tp-logo-img {
    height: var(--tp-logo-height);
    width: auto;
    max-width: none;
    object-fit: contain;
    display: block;
  }

  #TrustedPartners-{{ section.id }}.tp-grayscale .tp-logo-img {
    filter: grayscale(100%);
    opacity: 0.65;
    transition: filter 0.25s ease, opacity 0.25s ease;
  }

  #TrustedPartners-{{ section.id }}.tp-grayscale .tp-logo-item:hover .tp-logo-img,
  #TrustedPartners-{{ section.id }}.tp-grayscale .tp-logo-item:focus-within .tp-logo-img {
    filter: none;
    opacity: 1;
  }

  #TrustedPartners-{{ section.id }} .tp-logo-name {
    font-family: inherit;
    font-size: 13px;
    font-weight: 500;
    color: {{ section.settings.heading_color }};
    text-align: center;
    white-space: nowrap;
  }

  #TrustedPartners-{{ section.id }} .tp-logo-link {
    display: inline-flex;
  }

  @media (prefers-reduced-motion: reduce) {
    #TrustedPartners-{{ section.id }} .tp-track.is-marquee {
      animation: none;
      width: 100%;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Trusted partners",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Trusted Retail Partners" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Available On Pharmacies Near You" },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "checkbox", "id": "show_names", "label": "Show partner name under each logo", "default": false },

    { "type": "header", "content": "Colors & borders" },
    { "type": "color", "id": "background_color", "label": "Background color", "default": "#FAF9F6" },
    { "type": "color", "id": "subheading_color", "label": "Subheading color", "default": "#3B5BDB" },
    { "type": "color", "id": "heading_color", "label": "Heading color", "default": "#1A1A1A" },
    { "type": "color", "id": "border_color", "label": "Border/divider color", "default": "#E5E2DC" },
    { "type": "checkbox", "id": "show_top_border", "label": "Show top border", "default": true },
    { "type": "checkbox", "id": "show_divider", "label": "Show line under heading", "default": true },
    { "type": "checkbox", "id": "show_bottom_border", "label": "Show bottom border", "default": true },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Top padding — desktop", "default": 80 },
    { "type": "range", "id": "padding_bottom_desktop", "min": 0, "max": 150, "step": 5, "unit": "px", "label": "Bottom padding — desktop", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding — mobile", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding — mobile", "default": 40 },
    { "type": "range", "id": "heading_spacing_desktop", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Space below heading — desktop", "info": "Gap between the heading block and the logo row", "default": 48 },
    { "type": "range", "id": "heading_spacing_mobile", "min": 0, "max": 80, "step": 4, "unit": "px", "label": "Space below heading — mobile", "default": 28 },

    { "type": "header", "content": "Heading typography" },
    { "type": "range", "id": "subheading_size_desktop", "min": 10, "max": 24, "step": 1, "unit": "px", "label": "Subheading size — desktop", "default": 14 },
    { "type": "range", "id": "subheading_size_mobile", "min": 10, "max": 20, "step": 1, "unit": "px", "label": "Subheading size — mobile", "default": 12 },
    { "type": "range", "id": "heading_size_desktop", "min": 20, "max": 60, "step": 1, "unit": "px", "label": "Heading size — desktop", "default": 36 },
    { "type": "range", "id": "heading_size_mobile", "min": 16, "max": 40, "step": 1, "unit": "px", "label": "Heading size — mobile", "default": 24 },

    { "type": "header", "content": "Logos" },
    { "type": "range", "id": "logo_height_desktop", "min": 24, "max": 100, "step": 2, "unit": "px", "label": "Logo height — desktop", "default": 48 },
    { "type": "range", "id": "logo_height_mobile", "min": 20, "max": 70, "step": 2, "unit": "px", "label": "Logo height — mobile", "default": 32 },
    { "type": "range", "id": "logo_gap_desktop", "min": 8, "max": 100, "step": 4, "unit": "px", "label": "Gap between logos — desktop", "default": 56 },
    { "type": "range", "id": "logo_gap_mobile", "min": 8, "max": 60, "step": 4, "unit": "px", "label": "Gap between logos — mobile", "default": 28 },
    { "type": "checkbox", "id": "grayscale_logos", "label": "Show logos in grayscale (full color on hover)", "default": false },

    { "type": "header", "content": "Animation" },
    { "type": "checkbox", "id": "enable_animation", "label": "Enable continuous scrolling animation", "default": true },
    {
      "type": "select",
      "id": "animation_direction",
      "label": "Scroll direction",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "range", "id": "animation_speed", "min": 10, "max": 60, "step": 5, "unit": "s", "label": "Scroll speed (seconds per loop)", "default": 30 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "Pause on hover", "default": true }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo image" },
        { "type": "text", "id": "name", "label": "Partner name", "default": "Partner name", "info": "Used as alt text and optional label" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trusted partners",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
