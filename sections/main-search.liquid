{%- comment -%}
  Search results page, styled and behaving like the collection product grid
  (same filter sidebar, active-filter pills, price range slider, AJAX
  re-fetching, grid/pagination) but driven by the `search` object instead of
  `collection`, and with no banner - just a "Results for ..." heading.

  Custom element tags are deliberately named differently from
  main-collection-product-grid.liquid's (search-filters/search-results vs.
  collection-filters/collection-results) to avoid any customElements.define
  collision if both sections' scripts ever end up loaded on the same page;
  price-range-slider is genuinely shared (identical, generic implementation)
  and guarded with customElements.get() in both places instead.
{%- endcomment -%}

{%- liquid
  assign has_quick_links = false
  if section.settings.quick_link_1_text != blank and section.settings.quick_link_1_url != blank
    assign has_quick_links = true
  elsif section.settings.quick_link_2_text != blank and section.settings.quick_link_2_url != blank
    assign has_quick_links = true
  elsif section.settings.quick_link_3_text != blank and section.settings.quick_link_3_url != blank
    assign has_quick_links = true
  elsif section.settings.quick_link_4_text != blank and section.settings.quick_link_4_url != blank
    assign has_quick_links = true
  endif

  assign show_sidebar = false
  if section.settings.enable_filtering or has_quick_links
    assign show_sidebar = true
  endif

  assign clear_all_url = routes.search_url | append: '?q=' | append: search.terms | append: '&type=product'
-%}

<search-results
  class="search-grid-section section-padding"
  data-section-id="{{ section.id }}"
  data-search-terms="{{ search.terms | escape }}"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px; --grid-columns-mobile: {{ section.settings.columns_mobile }}; --grid-columns-desktop: {{ section.settings.columns_desktop }};"
>
  <div class="container">
    <div class="search-results__searchbar">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-results__form">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          class="search-results__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          aria-label="{{ 'general.search.placeholder' | t }}"
        >
        <button type="submit" class="search-results__submit" aria-label="{{ 'general.search.submit' | t }}">
          {% render 'icon', name: 'search' %}
        </button>
      </form>
    </div>

    <h1 class="search-results__heading">
      {%- if search.performed -%}
        {{ 'general.search.results_for' | t: terms: search.terms }}
      {%- else -%}
        {{ 'general.search.placeholder' | t }}
      {%- endif -%}
    </h1>

    {%- if search.performed == false -%}
      <p class="search-results__empty">{{ 'general.search.enter_a_search_term' | t }}</p>
    {%- else -%}
      {%- paginate search.results by section.settings.products_per_page -%}
        <div class="collection-layout{% if show_sidebar %} collection-layout--has-sidebar{% endif %}">
          <div class="collection-topbar">
            {%- if show_sidebar -%}
              <search-filters class="collection-filters">
                <button
                  type="button"
                  class="collection-filters__toggle"
                  aria-expanded="false"
                  aria-controls="SearchFiltersPanel-{{ section.id }}"
                >
                  {% render 'icon', name: 'filter' %}
                  <span>{{ 'products.facets.filter_button' | t }}</span>
                </button>
                <div class="collection-filters__backdrop" data-filters-backdrop hidden></div>
                <div
                  class="collection-filters__panel"
                  id="SearchFiltersPanel-{{ section.id }}"
                  role="dialog"
                  aria-modal="true"
                  aria-label="{{ 'products.facets.filter_button' | t }}"
                  hidden
                >
                  <div class="collection-filters__panel-header">
                    <p class="collection-filters__panel-heading">{{ 'products.facets.filter_button' | t }}</p>
                    <button type="button" class="collection-filters__panel-close" data-filters-close aria-label="{{ 'general.accessibility.close' | t }}">
                      {% render 'icon', name: 'close' %}
                    </button>
                  </div>
                  <div class="collection-filters__panel-inner" data-filters-panel>
                    {% render 'facets', results: search, nav_menu: blank, has_quick_links: has_quick_links, section: section %}
                  </div>
                </div>
              </search-filters>
            {%- elsif section.settings.enable_sorting -%}
              {%- comment -%} No filter groups to show, but the sort <select> still needs a form to submit via its form="" attribute. {%- endcomment -%}
              <form id="FacetFiltersForm-{{ section.id }}" class="visually-hidden"></form>
            {%- endif -%}

            <p class="collection-toolbar__count" role="status">
              <span data-product-count>
                {{ 'products.facets.product_count_simple' | t: count: search.results_count }}
              </span>
            </p>

            {%- if section.settings.enable_sorting -%}
              <div class="collection-toolbar__sort">
                <label for="SortBy-{{ section.id }}" class="collection-toolbar__sort-label">{{ 'products.facets.sort_by_label' | t }}</label>
                <select name="sort_by" form="FacetFiltersForm-{{ section.id }}" id="SortBy-{{ section.id }}" class="collection-toolbar__select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  {%- for option in search.sort_options -%}
                    <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endif -%}
          </div>

          <div data-grid-container>
            {%- if search.results.size == 0 -%}
              <div class="collection-empty">
                <p class="h4">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
                {%- if show_sidebar -%}
                  <p>{{ 'collections.general.use_fewer_filters_html' | t: link: clear_all_url, class: 'collection-empty__link' }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
              <ul class="collection-grid" id="search-grid-{{ section.id }}">
                {%- for item in search.results -%}
                  <li class="collection-grid__item">
                    {% render 'product-card', product: item %}
                  </li>
                {%- endfor -%}
              </ul>

              {%- if paginate.pages > 1 -%}
                <nav class="pagination" aria-label="pagination">
                  {%- if paginate.previous -%}
                    <a href="{{ paginate.previous.url }}" class="pagination__link pagination__link--prev" aria-label="{{ 'collections.general.pagination_previous' | t }}">{% render 'icon', name: 'chevron-right' %}</a>
                  {%- endif -%}
                  {%- for part in paginate.parts -%}
                    {%- if part.is_link -%}
                      <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
                    {%- else -%}
                      <span class="pagination__link{% if part.title == paginate.current_page %} pagination__link--current{% endif %}" {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if paginate.next -%}
                    <a href="{{ paginate.next.url }}" class="pagination__link" aria-label="{{ 'collections.general.pagination_next' | t }}">{% render 'icon', name: 'chevron-right' %}</a>
                  {%- endif -%}
                </nav>
              {%- endif -%}
            {%- endif -%}
          </div>
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</search-results>

{% stylesheet %}
search-results,
search-filters,
price-range-slider {
  display: block;
}

facet-filters-form {
  display: block;
}

.search-results__searchbar {
  max-width: 600px;
  margin: 0 auto 32px;
}

.search-results__form {
  position: relative;
  display: flex;
}

.search-results__input {
  width: 100%;
  padding: 14px 52px 14px 20px;
  border: 1px solid #eceff1;
  border-radius: var(--radius-m);
  background: var(--color-background);
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--color-primary);
}

.search-results__input:focus {
  outline: none;
  border-color: var(--color-secondary);
}

.search-results__submit {
  position: absolute;
  top: 50%;
  right: 6px;
  transform: translateY(-50%);
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  border-radius: 50%;
  background: transparent;
  color: var(--color-primary);
  cursor: pointer;
}

.search-results__heading {
  margin: 0 0 24px;
  font-family: var(--font-heading);
  text-align: center;
}

.search-results__empty {
  text-align: center;
  color: var(--color-text);
  padding: 60px 0;
}

/* ---------- Layout (identical structure to the collection grid) ---------- */
.collection-layout {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

@media screen and (min-width: 990px) {
  .collection-layout--has-sidebar {
    display: grid;
    grid-template-columns: 260px 1fr;
    column-gap: 36px;
    row-gap: 24px;
  }

  .collection-layout--has-sidebar .collection-topbar {
    display: contents;
  }

  .collection-layout--has-sidebar .collection-filters,
  .collection-layout--has-sidebar > .collection-topbar > form.visually-hidden {
    grid-column: 1;
    grid-row: 1 / span 2;
  }

  .collection-layout--has-sidebar .collection-toolbar__count {
    grid-column: 2;
    grid-row: 1;
    justify-self: start;
  }

  .collection-layout--has-sidebar .collection-toolbar__sort {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
  }

  .collection-layout--has-sidebar [data-grid-container] {
    grid-column: 2;
    grid-row: 2;
  }
}

.collection-topbar {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 12px;
}

.collection-topbar > search-filters,
.collection-topbar > form.visually-hidden {
  grid-column: 1;
}

.collection-toolbar__count {
  grid-column: 2;
  margin: 0;
  text-align: center;
  font-size: 13px;
  color: #55636b;
}

@media screen and (max-width: 600px) {
  .collection-toolbar__count {
    display: none;
  }
}

.collection-toolbar__sort {
  grid-column: 3;
}

/* ---------- Filter drawer (mobile/tablet) / static sidebar (desktop) ---------- */
.collection-filters__toggle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  background: #fff;
  border: 1px solid #eceff1;
  border-radius: 999px;
  color: var(--color-primary);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;

  @media screen and (max-width: 480px) {
    padding: 7px 15px;
  }
}

.collection-filters__backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 10010;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.collection-filters__backdrop.is-open {
  opacity: 1;
  pointer-events: auto;
}

.collection-filters__panel {
  position: fixed;
  top: 0;
  left: 0;
  bottom: 0;
  width: 90%;
  max-width: 380px;
  background: var(--color-background);
  z-index: 10011;
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.3s ease;
}

.collection-filters__panel.is-open {
  transform: translateX(0);
}

.collection-filters__panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px;
  border-bottom: 1px solid #eceff1;
  flex-shrink: 0;
}

.collection-filters__panel-heading {
  margin: 0;
  font-family: var(--font-heading);
  font-size: 18px;
  color: var(--color-primary);
}

.collection-filters__panel-close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  margin: -11px;
  padding: 11px;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-primary);
}

.collection-filters__panel-inner {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
}

body.search-filters-open {
  overflow: hidden;
}

@media screen and (min-width: 990px) {
  .collection-filters__toggle,
  .collection-filters__backdrop,
  .collection-filters__panel-header {
    display: none;
  }

  .collection-filters__panel {
    position: static;
    width: auto;
    max-width: none;
    transform: none;
    background: none;
    z-index: auto;
  }

  .collection-filters__panel[hidden] {
    display: block;
  }

  .collection-filters__panel-inner {
    padding: 0;
    overflow: visible;
  }
}

/* ---------- Facets ---------- */
.facets {
  display: flex;
  flex-direction: column;
}

.facets__group {
  border-bottom: 1px solid #eceff1;
  padding: 14px 0;
}

.facets__group:first-child {
  padding-top: 0;
}

.facets__group--link {
  display: block;
  color: inherit;
}

.facets__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  cursor: pointer;
  list-style: none;
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 600;
  color: var(--color-primary);
}

.facets__summary::-webkit-details-marker {
  display: none;
}

.facets__chevron {
  display: flex;
  color: var(--color-primary);
  transition: transform 0.2s ease;
}

details[open] > .facets__summary .facets__chevron--down {
  transform: rotate(180deg);
}

.facets__body {
  padding-top: 12px;
}

.facets__list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.facets__checkbox-label {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 14px;
  color: var(--color-primary);
  cursor: pointer;
}

.facets__item--disabled .facets__checkbox-label {
  color: #55636b;
  cursor: not-allowed;
}

.facets__checkbox {
  width: 16px;
  height: 16px;
  accent-color: var(--color-secondary);
  flex-shrink: 0;
}

.facets__count.text-muted {
  color: #55636b;
  font-size: 13px;
}

/* ---------- Active filter pills ---------- */
.active-filters {
  padding-bottom: 16px;
  margin-bottom: 4px;
  border-bottom: 1px solid #eceff1;
}

.active-filters__pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 10px;
}

.active-filters__pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  background: #eef2f4;
  border-radius: var(--radius-s);
  font-size: 12px;
  color: var(--color-primary);
  border: none;
  cursor: pointer;
}

.active-filters__remove,
.active-filters__remove-icon {
  display: flex;
  color: var(--color-primary);
}

.active-filters__remove {
  background: none;
  border: none;
  padding: 0;
  cursor: pointer;
}

.active-filters__clear-all.body-text {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-secondary);
}

/* ---------- Price range slider ---------- */
.price-range__slider {
  position: relative;
  height: 16px;
  margin-bottom: 14px;
}

.price-range__track {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 4px;
  border-radius: 2px;
  background: #eceff1;
  transform: translateY(-50%);
}

.price-range__progress {
  position: absolute;
  top: 50%;
  height: 4px;
  border-radius: 2px;
  background: var(--color-secondary);
  transform: translateY(-50%);
}

.price-range__thumb {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 16px;
  margin: 0;
  background: none;
  pointer-events: none;
  -webkit-appearance: none;
  appearance: none;
}

.price-range__thumb::-webkit-slider-runnable-track {
  background: transparent;
  height: 16px;
}

.price-range__thumb::-moz-range-track {
  background: transparent;
  height: 16px;
}

.price-range__thumb::-webkit-slider-thumb {
  -webkit-appearance: none;
  pointer-events: auto;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: var(--color-primary);
  cursor: pointer;
  margin-top: 0;
}

.price-range__thumb::-moz-range-thumb {
  pointer-events: auto;
  width: 16px;
  height: 16px;
  border: none;
  border-radius: 50%;
  background: var(--color-primary);
  cursor: pointer;
}

.price-range__values {
  display: flex;
  align-items: flex-end;
  flex-wrap: wrap;
  gap: 10px;
}

.price-range__field label {
  display: block;
  font-size: 12px;
  color: #55636b;
  margin-bottom: 4px;
}

.price-range__input-wrap {
  display: flex;
  align-items: center;
  gap: 4px;
  border: 1px solid #eceff1;
  border-radius: var(--radius-s);
  padding: 6px 10px;
}

.price-range__input {
  width: 60px;
  border: none;
  font-family: var(--font-body);
  font-size: 13px;
  color: var(--color-primary);
}

.price-range__input:focus {
  outline: none;
}

.price-range__separator {
  padding-bottom: 6px;
  color: #55636b;
}

/* ---------- Toolbar sort control ---------- */
.collection-toolbar__sort {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: var(--color-primary);
}

.collection-toolbar__select {
  font-family: var(--font-body);
  font-size: 13px;
  padding: 6px 10px;
  border: 1px solid #eceff1;
  border-radius: var(--radius-s);
  color: var(--color-primary);
}

@media screen and (max-width: 989px) {
  .collection-toolbar__sort-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
}

/* ---------- Grid ---------- */
.collection-grid {
  display: grid;
  grid-template-columns: repeat(var(--grid-columns-mobile, 2), minmax(0, 1fr));
  gap: 10px;
}

@media screen and (min-width: 768px) and (max-width: 1199px) {
  .collection-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
}

@media screen and (min-width: 1200px) {
  .collection-grid {
    grid-template-columns: repeat(var(--grid-columns-desktop, 4), minmax(0, 1fr));
    gap: 16px;
  }
}

[data-grid-container].is-loading {
  position: relative;
  pointer-events: none;
}

[data-grid-container].is-loading > * {
  opacity: 0.4;
}

[data-grid-container].is-loading::after {
  content: '';
  position: absolute;
  top: 120px;
  left: 50%;
  width: 28px;
  height: 28px;
  margin-left: -14px;
  border: 3px solid #eceff1;
  border-top-color: var(--button-primary, var(--color-secondary));
  border-radius: 50%;
  animation: button-spin 0.6s linear infinite;
}

.collection-empty {
  text-align: center;
  padding: 60px 0;
  color: var(--color-primary);
}

.collection-empty__link {
  color: var(--color-secondary);
  font-weight: 600;
  text-decoration: underline;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 32px;
}

.pagination__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  height: 36px;
  padding: 0 6px;
  border-radius: var(--radius-s);
  color: var(--color-primary);
  font-size: 13px;
}

.pagination__link--current {
  background: var(--color-secondary);
  color: #fff;
}

.pagination__link--prev svg {
  transform: scaleX(-1);
}
{% endstylesheet %}

{% javascript %}
class SearchFilters extends HTMLElement {
  #toggle
  #backdrop
  #panel
  #closeButton
  #lastFocused

  constructor() {
    super()
    this.#toggle = this.querySelector('.collection-filters__toggle')
    this.#backdrop = this.querySelector('[data-filters-backdrop]')
    this.#panel = this.querySelector('.collection-filters__panel')
    this.#closeButton = this.querySelector('[data-filters-close]')
    if (!this.#panel) return

    this.#toggle?.addEventListener('click', () => this.open())
    this.#closeButton?.addEventListener('click', () => this.close())
    this.#backdrop?.addEventListener('click', () => this.close())
    document.addEventListener('keydown', (event) => this.#onKeydown(event))
  }

  open() {
    this.#lastFocused = document.activeElement
    this.#panel.hidden = false
    if (this.#backdrop) this.#backdrop.hidden = false
    requestAnimationFrame(() => {
      this.#panel.classList.add('is-open')
      this.#backdrop?.classList.add('is-open')
    })
    this.#toggle?.setAttribute('aria-expanded', 'true')
    document.body.classList.add('search-filters-open')
    this.#closeButton?.focus()
  }

  close() {
    this.#panel.classList.remove('is-open')
    this.#backdrop?.classList.remove('is-open')
    this.#toggle?.setAttribute('aria-expanded', 'false')
    document.body.classList.remove('search-filters-open')
    window.setTimeout(() => {
      if (!this.#panel.classList.contains('is-open')) {
        this.#panel.hidden = true
        if (this.#backdrop) this.#backdrop.hidden = true
      }
    }, 300)
    this.#lastFocused?.focus()
  }

  #onKeydown(event) {
    if (event.key === 'Escape' && this.#panel.classList.contains('is-open')) this.close()
  }
}

class PriceRangeSlider extends HTMLElement {
  #minThumb
  #maxThumb
  #minInput
  #maxInput
  #progress
  #min
  #max

  constructor() {
    super()
    this.#minThumb = this.querySelector('[data-price-thumb-min]')
    this.#maxThumb = this.querySelector('[data-price-thumb-max]')
    this.#minInput = this.querySelector('[data-price-input-min]')
    this.#maxInput = this.querySelector('[data-price-input-max]')
    this.#progress = this.querySelector('[data-price-progress]')
    if (!this.#minThumb || !this.#maxThumb) return

    this.#min = Number(this.#minThumb.min)
    this.#max = Number(this.#minThumb.max)

    this.#minThumb.addEventListener('input', () => this.#onThumbInput('min'))
    this.#maxThumb.addEventListener('input', () => this.#onThumbInput('max'))
    this.#minThumb.addEventListener('pointerdown', () => this.#raise('min'))
    this.#maxThumb.addEventListener('pointerdown', () => this.#raise('max'))
    this.#minInput?.addEventListener('change', () => this.#onTextInput('min'))
    this.#maxInput?.addEventListener('change', () => this.#onTextInput('max'))

    this.#updateProgress()
  }

  #raise(which) {
    this.#minThumb.style.zIndex = which === 'min' ? '5' : '1'
    this.#maxThumb.style.zIndex = which === 'max' ? '5' : '1'
  }

  #onThumbInput(which) {
    let minVal = Number(this.#minThumb.value)
    let maxVal = Number(this.#maxThumb.value)
    if (minVal > maxVal) {
      if (which === 'min') {
        minVal = maxVal
        this.#minThumb.value = String(minVal)
      } else {
        maxVal = minVal
        this.#maxThumb.value = String(maxVal)
      }
    }
    if (this.#minInput) this.#minInput.value = String(minVal)
    if (this.#maxInput) this.#maxInput.value = String(maxVal)
    this.#updateProgress()
  }

  #onTextInput(which) {
    const raw = which === 'min' ? this.#minInput.value : this.#maxInput.value
    let value = Number.parseFloat(String(raw).replace(',', '.'))
    if (Number.isNaN(value)) value = which === 'min' ? this.#min : this.#max
    value = Math.min(Math.max(value, this.#min), this.#max)

    if (which === 'min') {
      value = Math.min(value, Number(this.#maxThumb.value))
      this.#minThumb.value = String(value)
      this.#minInput.value = String(value)
    } else {
      value = Math.max(value, Number(this.#minThumb.value))
      this.#maxThumb.value = String(value)
      this.#maxInput.value = String(value)
    }
    this.#updateProgress()
  }

  #updateProgress() {
    if (!this.#progress) return
    const min = Number(this.#minThumb.value)
    const max = Number(this.#maxThumb.value)
    const range = this.#max - this.#min || 1
    const left = ((min - this.#min) / range) * 100
    const right = 100 - ((max - this.#min) / range) * 100
    this.#progress.style.left = `${left}%`
    this.#progress.style.right = `${right}%`
  }
}

class SearchResults extends HTMLElement {
  #sectionId
  #searchTerms
  #grid
  #count
  #filtersPanel

  constructor() {
    super()
    this.#sectionId = this.dataset.sectionId
    this.#searchTerms = this.dataset.searchTerms
    this.#grid = this.querySelector('[data-grid-container]')
    this.#count = this.querySelector('[data-product-count]')
    this.#filtersPanel = this.querySelector('[data-filters-panel]')

    this.addEventListener('change', (event) => this.#onChange(event))
    this.addEventListener('click', (event) => this.#onClick(event))
    window.addEventListener('popstate', () => this.#fetchAndRender(window.location.href, false))
  }

  #onChange(event) {
    const target = event.target
    if (!(target instanceof HTMLInputElement) && !(target instanceof HTMLSelectElement)) return

    if (
      target.matches('select[name="sort_by"]') ||
      target.matches('input[type="checkbox"]') ||
      target.matches('input[type="range"]') ||
      target.matches('[data-price-input-min], [data-price-input-max]')
    ) {
      this.#submitForm()
    }
  }

  #getFacetsForm() {
    return document.getElementById(`FacetFiltersForm-${this.#sectionId}`)
  }

  #onClick(event) {
    const priceRemove = event.target.closest('[data-price-pill] .active-filters__remove')
    if (priceRemove) {
      const pill = priceRemove.closest('[data-price-pill]')
      const form = this.#getFacetsForm()
      const minInput = form?.querySelector(`[name="${pill.dataset.minName}"]`)
      const maxInput = form?.querySelector(`[name="${pill.dataset.maxName}"]`)
      if (minInput) minInput.value = ''
      if (maxInput) maxInput.value = ''
      this.#submitForm()
      return
    }

    const link = event.target.closest(
      '.active-filters__pill[href], .active-filters__clear-all[href], .pagination__link[href]'
    )
    if (link) {
      event.preventDefault()
      this.#fetchAndRender(link.href)
    }
  }

  #submitForm() {
    const form = this.#getFacetsForm()
    if (!form) return
    const params = new URLSearchParams(new FormData(form))
    params.set('q', this.#searchTerms)
    params.set('type', 'product')

    const minThumb = this.querySelector('[data-price-thumb-min]')
    const maxThumb = this.querySelector('[data-price-thumb-max]')
    const minInput = this.querySelector('[data-price-input-min]')
    const maxInput = this.querySelector('[data-price-input-max]')
    if (minThumb && maxThumb && minInput && maxInput) {
      const atDefaultRange =
        Number(minInput.value || 0) <= Number(minThumb.min) &&
        Number(maxInput.value || maxThumb.max) >= Number(maxThumb.max)
      if (atDefaultRange) {
        params.delete(minInput.name)
        params.delete(maxInput.name)
      }
    }

    for (const [key, value] of [...params]) {
      if (value === '') params.delete(key)
    }
    const url = `${window.location.pathname}?${params.toString()}`
    this.#fetchAndRender(url)
  }

  async #fetchAndRender(url, pushHistory = true) {
    this.#grid?.classList.add('is-loading')
    const separator = url.includes('?') ? '&' : '?'

    // The panel swap below replaces every <details> wholesale, so any group
    // the shopper had manually expanded (that isn't also "active", which is
    // the only thing the freshly-rendered HTML knows to open) would otherwise
    // silently collapse on every filter change.
    const openParams = new Set(
      Array.from(this.querySelectorAll('[data-filters-panel] details[open]')).map((details) => details.dataset.filterParam)
    )

    try {
      const response = await fetch(`${url}${separator}section_id=${this.#sectionId}`)
      const text = await response.text()
      const doc = new DOMParser().parseFromString(text, 'text/html')

      const newGrid = doc.querySelector('[data-grid-container]')
      if (newGrid && this.#grid) {
        this.#grid.innerHTML = newGrid.innerHTML
        window.avadaAirReviewRerender?.()
      }

      const newCount = doc.querySelector('[data-product-count]')
      if (newCount && this.#count) this.#count.innerHTML = newCount.innerHTML

      const newFiltersPanel = doc.querySelector('[data-filters-panel]')
      if (newFiltersPanel && this.#filtersPanel) {
        this.#filtersPanel.innerHTML = newFiltersPanel.innerHTML
        for (const details of this.#filtersPanel.querySelectorAll('details[data-filter-param]')) {
          if (openParams.has(details.dataset.filterParam)) details.open = true
        }
      }

      if (pushHistory) history.pushState({}, '', url)
    } finally {
      this.#grid?.classList.remove('is-loading')
    }
  }
}

if (!customElements.get('search-filters')) customElements.define('search-filters', SearchFilters)
if (!customElements.get('price-range-slider')) customElements.define('price-range-slider', PriceRangeSlider)
if (!customElements.get('search-results')) customElements.define('search-results', SearchResults)
{% endjavascript %}

