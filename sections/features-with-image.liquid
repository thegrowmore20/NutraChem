<section class="features-section section-padding" style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% render 'section-header', heading: section.settings.heading %}

    {%- assign left_blocks = section.blocks | where: 'type', 'feature' | slice: 0, 2 -%}
    {%- assign right_blocks = section.blocks | where: 'type', 'feature' | slice: 2, 2 -%}

    <div class="u-grid u-items-center features-grid">
      <div class="u-flex u-flex-col features-col">
        {%- for block in left_blocks -%}
          <div class="u-flex feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="feature-item__icon">
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy', width: 88, height: 88, alt: '' }}
              </span>
            {%- endif -%}
            <div>
              <h3 class="feature-item__title">{{ block.settings.title }}</h3>
              <p class="feature-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <div class="u-flex u-justify-center features-media">
        {%- if section.settings.image -%}
          {%- assign media_h = 700 | divided_by: section.settings.image.aspect_ratio | round -%}
          {%- assign media_alt = section.settings.image.alt | default: section.settings.heading -%}
          {{ section.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 500, 700', sizes: '(min-width: 990px) 33vw, 100vw', width: 700, height: media_h, alt: media_alt }}
        {%- else -%}
          <img src="{{ 'Group 79.png' | asset_url }}" width="438" height="509" loading="lazy" alt="{{ section.settings.heading }}">
        {%- endif -%}
      </div>

      <div class="u-flex u-flex-col features-col">
        {%- for block in right_blocks -%}
          <div class="u-flex feature-item" {{ block.shopify_attributes }}>
            {%- if block.settings.image -%}
              <span class="feature-item__icon">
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy', width: 88, height: 88, alt: '' }}
              </span>
            {%- endif -%}
            <div>
              <h3 class="feature-item__title">{{ block.settings.title }}</h3>
              <p class="feature-item__text">{{ block.settings.text }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.features-grid {
  grid-template-columns: 1fr;
  gap: 40px;
}

@media screen and (min-width: 990px) {
  .features-grid {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr);
  }
}

.features-col {
  gap: 36px;
}

.feature-item {
  gap: 18px;
}

.feature-item__icon {
  width: 74px;
  flex-shrink: 0;
  color: var(--color-secondary);
}

.feature-item__icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.feature-item__title {
  font-size: 19px;
  color: #153343;
  margin: 0 0 var(--space-2);
  font-weight: 600;
  font-family: var(--font-accent);
}

.feature-item__text {
  font-size: 16px;
  color: #153343;
  line-height: 1.6;
  margin: 0;

  @media screen and (max-width: 600px) {
    line-height: 1.3;
  }
}

.features-media {
  position: relative;
}

@media screen and (max-width: 989px) {
  .features-col:first-of-type {
    order: 0;
  }

  .features-media {
    order: 1;
  }

  .features-col:last-of-type {
    order: 2;
  }
}

.features-media img {
  max-height: 460px;
  object-fit: cover;

  @media screen and (max-width: 1199px) {
    max-height: 350px;
  }

  @media screen and (max-width: 992px) {
    max-height: fit-content;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Features with image",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Pakistanis Trust Shivora for Skincare"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Center image"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "100% Organic Ingredients"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Features with image",
      "blocks": [
        { "type": "feature", "settings": { "title": "100% Organic Ingredients", "text": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care." } },
        { "type": "feature", "settings": { "title": "Made for Local Skin Needs", "text": "Pure, organic, and halal-certified skincare made with nature's finest ingredients. Free from harsh chemicals for gentle, effective care." } },
        { "type": "feature", "settings": { "title": "Easy to use", "text": "Science-backed skincare combining natural ingredients with proven formulas for effective results." } },
        { "type": "feature", "settings": { "title": "Results You Can See", "text": "Science-backed skincare combining natural ingredients with proven formulas for effective results." } }
      ]
    }
  ]
}
{% endschema %}
