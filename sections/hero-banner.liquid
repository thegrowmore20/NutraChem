<section
  class="u-flex hero hero--height-{{ section.settings.height }} hero--height-mobile-{{ section.settings.mobile_height | default: section.settings.height }}"
  style="
    {%- if section.settings.height == 'custom' %}--hero-height: {{ section.settings.custom_height }}px;{% endif -%}
    {%- if section.settings.mobile_height == 'custom' %}--hero-height-mobile: {{ section.settings.custom_height_mobile }}px;{% endif -%}
  "
>
  {%- assign hero_image = section.settings.image | default: section.settings.mobile_image -%}
  {%- if hero_image -%}
    {%- liquid
      assign hero_h = 3200 | divided_by: hero_image.aspect_ratio | round
      assign hero_loading = 'lazy'
      assign hero_priority = 'auto'
      if section.index == 1
        assign hero_loading = 'eager'
        assign hero_priority = 'high'
      endif
      assign hero_alt = hero_image.alt | default: ''
    -%}
    <picture class="hero__picture">
      {%- if section.settings.mobile_image -%}
        <source
          media="(max-width: 749px)"
          srcset="{{ section.settings.mobile_image | image_url: width: 375 }} 375w, {{ section.settings.mobile_image | image_url: width: 550 }} 550w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1100 }} 1100w, {{ section.settings.mobile_image | image_url: width: 1500 }} 1500w"
          sizes="100vw"
          width="{{ section.settings.mobile_image.width }}"
          height="{{ section.settings.mobile_image.height }}"
        >
      {%- endif -%}
    {{
      hero_image
      | image_url: width: 3200
      | image_tag:
        loading: hero_loading,
        fetchpriority: hero_priority,
        sizes: '100vw',
        widths: '750, 990, 1200, 1500, 1920, 2400, 3200',
        width: 3200,
        height: hero_h,
        class: 'hero__image',
        alt: hero_alt
    }}
    </picture>
  {%- endif -%}

  {%- if section.settings.show_overlay -%}
    <div class="hero__overlay" style="background: {{ section.settings.overlay_color }};"></div>
  {%- endif -%}

  {%- if section.settings.heading != blank or section.settings.text != blank or section.settings.button_label != blank -%}
    <div class="u-flex u-items-center hero__content-wrap container hero__content-wrap--x-{{ section.settings.content_position_x }} hero__content-wrap--y-{{ section.settings.content_position_y }} hero__content-wrap--x-mobile-{{ section.settings.content_position_x_mobile }} hero__content-wrap--y-mobile-{{ section.settings.content_position_y_mobile }}">
      <div class="hero__content">
        {%- if section.settings.heading != blank -%}
          <h1 class="hero__heading {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading }}</h1>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="hero__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="u-inline-flex button hero__button">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.hero {
  position: relative;
  overflow: hidden;
}

.hero--height-full {
  min-height: 100vh;
  min-height: 100svh;
}

.hero--height-small {
  min-height: 410px;
}

.hero--height-medium {
  min-height: 550px;
}

.hero--height-large {
  min-height: 640px;
}

.hero--height-custom {
  min-height: var(--hero-height, 640px);
}

.hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero__picture {
  position: absolute;
  inset: 0;
  z-index: 0;
}

.hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero__content-wrap {
  position: relative;
  z-index: 2;
  padding-block: 48px;
  justify-content: flex-start;
}

.hero__content-wrap--x-left {
  justify-content: flex-start;
}

.hero__content-wrap--x-center {
  justify-content: center;
  text-align: center;
}

.hero__content-wrap--x-right {
  justify-content: flex-end;
}

.hero__content-wrap--y-top {
  align-items: flex-start;
  padding-top: 48px;
}

.hero__content-wrap--y-center {
  align-items: center;
}

.hero__content-wrap--y-bottom {
  align-items: flex-end;
  padding-bottom: 48px;
}

.hero__content {
  max-width: 520px;
  line-height: normal;
}

.hero__heading {
  margin: 0 0 var(--space-4);
}

.hero__text {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
  margin: 0 0 var(--space-6);
}

.hero__button {
  background: var(--color-secondary-a11y, var(--color-secondary));
  color: #fff;
}

@media screen and (max-width: 749px) {
  .hero--height-mobile-full {
    min-height: 100vh;
    min-height: 100svh;
  }

  .hero--height-mobile-small {
    min-height: 300px;
  }

  .hero--height-mobile-medium {
    min-height: 400px;
  }

  .hero--height-mobile-large {
    min-height: 500px;
  }

  .hero--height-mobile-custom {
    min-height: var(--hero-height-mobile, 400px);
  }

  .hero__content {
    max-width: 320px;
  }

  .hero__content-wrap--x-mobile-left {
    justify-content: flex-start;
  }

  .hero__content-wrap--x-mobile-center {
    justify-content: center;
    text-align: center;
  }

  .hero__content-wrap--x-mobile-right {
    justify-content: flex-end;
  }

  .hero__content-wrap--y-mobile-top {
    align-items: flex-start;
    padding-top: 48px;
    padding-bottom: 0;
  }

  .hero__content-wrap--y-mobile-center {
    align-items: center;
    padding-block: 0;
  }

  .hero__content-wrap--y-mobile-bottom {
    align-items: flex-end;
    padding-bottom: 48px;
    padding-top: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile background image",
      "info": "Optional. Uses the background image when left empty."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Minimum banner height",
      "options": [
        { "value": "full", "label": "Full height" },
        { "value": "small", "label": "Small (410px)" },
        { "value": "medium", "label": "Medium (550px)" },
        { "value": "large", "label": "Large (640px)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 640,
      "visible_if": "{{ section.settings.height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "mobile_height",
      "label": "Minimum banner height (mobile)",
      "options": [
        { "value": "full", "label": "Full height" },
        { "value": "small", "label": "Small (300px)" },
        { "value": "medium", "label": "Medium (400px)" },
        { "value": "large", "label": "Large (500px)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "full"
    },
    {
      "type": "range",
      "id": "custom_height_mobile",
      "label": "Custom height (mobile)",
      "min": 200,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 400,
      "visible_if": "{{ section.settings.mobile_height == 'custom' }}"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": false
    },
    {
      "type": "color_background",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "rgba(0, 0, 0, 0.4)"
    },
    {
      "type": "select",
      "id": "content_position_x",
      "label": "Content horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_y",
      "label": "Content vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_position_x_mobile",
      "label": "Content horizontal position (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_y_mobile",
      "label": "Content vertical position (mobile)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Beauty Begins with care"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#18252B"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "H0" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h0"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We combine natural extracts with clinical research to give you skin results you can actually see. No fillers, just pure potency.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
