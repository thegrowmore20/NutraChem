{%- liquid
  assign banner_image = section.settings.image | default: collection.image
  assign heading = section.settings.heading | default: collection.title

  assign show_text = false
  if section.settings.text != blank
    assign show_text = true
  elsif section.settings.show_collection_description and collection.description != blank
    assign show_text = true
  endif
-%}

<section
  class="hero collection-hero hero--height-{{ section.settings.height }}"
  {%- if section.settings.height == 'custom' %} style="--hero-height: {{ section.settings.custom_height }}px;"{% endif -%}
>
  {%- if banner_image -%}
    {%- assign hero_h = 3200 | divided_by: banner_image.aspect_ratio | round -%}
    {{
      banner_image
      | image_url: width: 3200
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        widths: '750, 990, 1200, 1500, 1920, 2400, 3200',
        width: 3200,
        height: hero_h,
        class: 'hero__image',
        alt: banner_image.alt | default: heading
    }}
  {%- else -%}
    {{ 'collection-1' | placeholder_svg_tag: 'hero__image' }}
  {%- endif -%}

  <div class="u-flex u-items-center hero__content-wrap container hero__content-wrap--x-{{ section.settings.content_position_x }} hero__content-wrap--y-{{ section.settings.content_position_y }} hero__content-wrap--x-mobile-{{ section.settings.content_position_x_mobile }} hero__content-wrap--y-mobile-{{ section.settings.content_position_y_mobile }}">
    <div class="hero__content">
      <h1 class="hero__heading {{ section.settings.heading_size }}" style="color: {{ section.settings.heading_color }};">{{ heading }}</h1>
      {%- if show_text -%}
        <div class="hero__text">
          {%- if section.settings.text != blank -%}
            {{ section.settings.text }}
          {%- else -%}
            {{ collection.description }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* Duplicated from sections/hero-banner.liquid: section stylesheet bundles are
   scoped per section type actually rendered on the page, so this section
   can't rely on hero-banner's CSS being present on a collection page. */
.hero {
  position: relative;
  overflow: hidden;
}

.hero--height-full {
  min-height: 100vh;
}

.hero--height-small {
  min-height: 410px;
}

.hero--height-medium {
  min-height: 550px;
}

.hero--height-large {
  min-height: 640px;
}

.hero--height-custom {
  min-height: var(--hero-height, 640px);
}

.hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.hero__content-wrap {
  position: absolute;
  inset: 0;
  justify-content: flex-start;
}

.hero__content-wrap--x-left {
  justify-content: flex-start;
}

.hero__content-wrap--x-center {
  justify-content: center;
  text-align: center;
}

.hero__content-wrap--x-right {
  justify-content: flex-end;
}

.hero__content-wrap--y-top {
  align-items: flex-start;
  padding-top: 48px;
}

.hero__content-wrap--y-center {
  align-items: center;
}

.hero__content-wrap--y-bottom {
  align-items: flex-end;
  padding-bottom: 48px;
}

.hero__content {
  max-width: 520px;
  line-height: normal;
}

.hero__heading {
  margin: 0 0 16px;
}

.hero__text {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
  margin: 0 0 24px;
}

@media screen and (max-width: 749px) {
  .hero__content {
    max-width: 320px;
  }

  .hero__content-wrap--x-mobile-left {
    justify-content: flex-start;
  }

  .hero__content-wrap--x-mobile-center {
    justify-content: center;
    text-align: center;
  }

  .hero__content-wrap--x-mobile-right {
    justify-content: flex-end;
  }

  .hero__content-wrap--y-mobile-top {
    align-items: flex-start;
    padding-top: 48px;
    padding-bottom: 0;
  }

  .hero__content-wrap--y-mobile-center {
    align-items: center;
    padding-block: 0;
  }

  .hero__content-wrap--y-mobile-bottom {
    align-items: flex-end;
    padding-bottom: 48px;
    padding-top: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Collection banner",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Defaults to the collection's own image, then a placeholder, if left blank."
    },
    {
      "type": "select",
      "id": "height",
      "label": "Banner height",
      "options": [
        { "value": "full", "label": "Full height" },
        { "value": "small", "label": "Small (410px)" },
        { "value": "medium", "label": "Medium (550px)" },
        { "value": "large", "label": "Large (640px)" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "custom_height",
      "label": "Custom height",
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "default": 640,
      "visible_if": "{{ section.settings.height == 'custom' }}"
    },
    {
      "type": "select",
      "id": "content_position_x",
      "label": "Content horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_y",
      "label": "Content vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "content_position_x_mobile",
      "label": "Content horizontal position (mobile)",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_position_y_mobile",
      "label": "Content vertical position (mobile)",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Defaults to the collection's title if left blank."
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#18252B"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h0", "label": "H0" },
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Defaults to the collection's description if left blank."
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description when no text override is set",
      "default": true
    }
  ]
}
{% endschema %}
