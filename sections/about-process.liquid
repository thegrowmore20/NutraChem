{%- comment -%}
  About page process steps: auto-numbered cards (icon, heading, text, small
  caption line for a supporting stat/fact).
{%- endcomment -%}

<section
  class="about-process section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.description
    %}

    {%- if section.blocks.size > 0 -%}
      <div class="u-grid about-process__grid">
        {%- for block in section.blocks -%}
          <div class="about-process__card" {{ block.shopify_attributes }}>
            <div class="u-flex u-items-center u-justify-between about-process__card-header">
              <span class="about-process__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              {%- if block.settings.icon_image != blank -%}
                <span class="about-process__icon" aria-hidden="true">
                  {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', widths: '24, 48', sizes: '24px', width: 24, height: 24, alt: '' }}
                </span>
              {%- elsif block.settings.icon != blank -%}
                <span class="about-process__icon" aria-hidden="true">{{ block.settings.icon }}</span>
              {%- endif -%}
            </div>
            {%- if block.settings.heading != blank -%}
              <p class="about-process__card-heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-process__card-text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <p class="about-process__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-process__grid {
  grid-template-columns: 1fr;
  gap: var(--space-3);
}

@media screen and (min-width: 600px) {
  .about-process__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (min-width: 990px) {
  .about-process__grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
}

.about-process__card {
  padding: var(--space-7) var(--space-6);
  border-radius: var(--radius-m);
  border: 1px solid var(--color-surface);
  transform-origin: center;
  transition: transform 0.25s ease;
  backface-visibility: hidden;
}

.about-process__card:hover {
  transform: translateY(-5px);
}

.about-process__card-header {
  margin-bottom: var(--space-4);
}

.about-process__number {
  font-size: 48px;
  font-weight: 500;
  font-family: var(--font-heading);
  line-height: 1;
  color: color-mix(in srgb, var(--color-secondary) 30%, white);
}

.about-process__icon {
  font-size: 24px;
}

.about-process__icon img {
  display: block;
  width: 24px;
  height: 24px;
  object-fit: contain;
}

.about-process__card-heading {
  font-size: 17px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 var(--space-2);
}

.about-process__card-text {
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-muted);
  margin: 0 0 var(--space-3);
}

.about-process__caption {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-secondary);
  margin: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "About process",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How We Formulate" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From Research to Your Skin" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every NutraChem formula undergoes a rigorous multi-stage development process before it earns the right to exist. Here is exactly how a product is born.</p>"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "📚" },
        { "type": "image_picker", "id": "icon_image", "label": "Icon image", "info": "Overrides the emoji icon above when set." },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Literature Review" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About process",
      "blocks": [
        { "type": "step", "settings": { "icon": "📚", "heading": "Literature Review", "text": "Our scientists review thousands of peer-reviewed papers to identify the most clinically supported actives.", "caption": "200+ studies reviewed per formula" } },
        { "type": "step", "settings": { "icon": "⚗️", "heading": "Compound Selection", "text": "We select only the most bioavailable form of each active, proven to penetrate the skin barrier.", "caption": "FDA GRAS & EU approved ingredients only" } },
        { "type": "step", "settings": { "icon": "🧪", "heading": "Lab Formulation", "text": "Compounds are combined at peer-reviewed concentrations. pH and delivery system are optimised for absorption.", "caption": "100+ iterations before finalised" } },
        { "type": "step", "settings": { "icon": "🔬", "heading": "Clinical Validation", "text": "Double-blind clinical testing with 100+ participants. No passing data means back to the lab.", "caption": "Independent CRO testing, no internal bias" } },
        { "type": "step", "settings": { "icon": "✅", "heading": "Safety & Stability", "text": "Patch testing, dermatologist review, and 12-month accelerated stability testing before any product ships.", "caption": "Dermatologist-tested, hypoallergenic" } },
        { "type": "step", "settings": { "icon": "📦", "heading": "Sustainable Launch", "text": "Recyclable packaging, fulfilled with care from our warehouse.", "caption": "Carbon-neutral shipping on all orders" } }
      ]
    }
  ]
}
{% endschema %}
