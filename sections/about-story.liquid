{%- comment -%}
  About page founder story: intro + a vertical milestone timeline + a
  founder card (image falls back to an icon avatar when none is set).
{%- endcomment -%}

<section
  class="about-story section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.description
    %}

    {%- if section.blocks.size > 0 -%}
      <ol class="u-flex u-flex-col about-story__timeline">
        {%- for block in section.blocks -%}
          <li class="about-story__milestone" {{ block.shopify_attributes }}>
            <span class="about-story__year">{{ block.settings.year }}</span>
            <div class="about-story__milestone-body">
              {%- if block.settings.title != blank -%}
                <p class="about-story__milestone-title">{{ block.settings.title }}</p>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="about-story__milestone-text">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if section.settings.founder_name != blank -%}
      <div class="u-flex u-items-center about-story__founder">
        <div class="u-flex u-items-center u-justify-center about-story__founder-media">
          {%- if section.settings.founder_image != blank -%}
            {{ section.settings.founder_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: section.settings.founder_name }}
          {%- else -%}
            {% render 'icon', name: 'user' %}
          {%- endif -%}
        </div>
        <div>
          <p class="about-story__founder-name">{{ section.settings.founder_name }}</p>
          {%- if section.settings.founder_role != blank -%}
            <p class="about-story__founder-role">{{ section.settings.founder_role }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-story__timeline {
  list-style: none;
  margin: 0 auto;
  padding: 0;
  max-width: 720px;
  gap: var(--space-7);
  border-left: 2px solid var(--color-surface);
}

.about-story__milestone {
  position: relative;
  padding-left: var(--space-7);
}

.about-story__milestone::before {
  content: '';
  position: absolute;
  left: -7px;
  top: 4px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--color-secondary);
}

.about-story__year {
  display: block;
  font-size: 18px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-secondary);
  margin-bottom: var(--space-1);
}

.about-story__milestone-title {
  font-size: 16px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 6px;
}

.about-story__milestone-text {
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-muted);
  margin: 0;
}

.about-story__founder {
  gap: var(--space-4);
  max-width: 720px;
  margin: 48px auto 0;
  padding-top: var(--space-8);
  border-top: 1px solid var(--color-surface);
}

.about-story__founder-media {
  flex-shrink: 0;
  width: 56px;
  height: 56px;
  border-radius: 50%;
  overflow: hidden;
  background: var(--color-surface);
  color: var(--color-primary);
}

.about-story__founder-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.about-story__founder-name {
  font-size: 15px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0;
}

.about-story__founder-role {
  font-size: 12px;
  font-weight: 600;
  font-family: var(--font-accent);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--color-text-muted);
  margin: 2px 0 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "About story",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Founder Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Lab, a Conviction, a Brand" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>NutraChem began driven by a growing frustration with skincare products that overpromised but failed to deliver real results.</p><p>Working closely with experienced formulation chemists, the brand was built on a simple standard: every product should meet high-performance benchmarks inspired by clinical research and real-world effectiveness.</p>"
    },
    { "type": "header", "content": "Founder" },
    { "type": "image_picker", "id": "founder_image", "label": "Founder image" },
    { "type": "text", "id": "founder_name", "label": "Founder name", "default": "Dr. Elena Vasquez" },
    { "type": "text", "id": "founder_role", "label": "Founder role", "default": "Co-Founder & Chief Scientist" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2022" },
        { "type": "text", "id": "title", "label": "Title", "default": "The Idea" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About story",
      "blocks": [
        { "type": "milestone", "settings": { "year": "2022", "title": "The Idea", "description": "Dr. Elena Vasquez begins formulating in her UCL research lab, frustrated by the gap between dermatological science and consumer skincare." } },
        { "type": "milestone", "settings": { "year": "2023", "title": "First Formula", "description": "The Radiance Serum prototype is validated in a double-blind study with 120 participants. 91% show measurable improvement in 28 days." } },
        { "type": "milestone", "settings": { "year": "2024", "title": "NutraChem Launches", "description": "Brand launches online with three products. Sells out in 72 hours." } },
        { "type": "milestone", "settings": { "year": "2025", "title": "Pharmacy Trusted", "description": "NutraChem products become available in pharmacies, reflecting our commitment to quality, safety, and real results you can trust." } },
        { "type": "milestone", "settings": { "year": "2026", "title": "Today", "description": "A team of scientists, formulators, and clinicians continuing to push the boundary of what premium skincare can be." } }
      ]
    }
  ]
}
{% endschema %}
