{%- comment -%}
  Password (coming soon) page. Uses layout/password.liquid, not theme.liquid -
  no header/footer/cart to render pre-launch. The login form is tucked behind
  a native <details> reveal so the page reads as "opening soon" first.
{%- endcomment -%}

<section
  class="password-page section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container password-page__inner">
    <h1 class="password-page__shop-name h2">{{ shop.name }}</h1>

    {%- if shop.password_message != blank -%}
      <div class="password-page__message rte">{{ shop.password_message }}</div>
    {%- else -%}
      <p class="password-page__message">{{ 'general.password_page.opening_soon' | t }}</p>
    {%- endif -%}

    <details class="password-page__reveal">
      <summary class="password-page__reveal-toggle">
        {{ 'general.password_page.login_form_heading' | t }}
      </summary>
      <div class="u-flex u-items-center u-flex-col password-page__form-wrap">
        {%- form 'storefront_password', class: 'password-page__form' -%}
          <label class="visually-hidden" for="Password">{{ 'general.password_page.login_form_password_placeholder' | t }}</label>
          <input
            type="password"
            name="password"
            id="Password"
            class="password-page__input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            {% if form.errors %}aria-invalid="true" aria-describedby="PasswordError"{% endif %}
          >
          {%- if form.errors -%}
            <p id="PasswordError" class="password-page__error" role="alert">
              {{ 'general.password_page.login_form_error' | t }}
            </p>
          {%- endif -%}
          <button type="submit" class="button button--dark password-page__submit">
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        {%- endform -%}
      </div>
    </details>
  </div>
</section>

{% stylesheet %}
.password-page__inner {
  max-width: 420px;
  margin: 0 auto;
  text-align: center;
}

.password-page__shop-name {
  margin: 0 0 16px;
  color: var(--color-primary);
}

.password-page__message {
  margin: 0 0 28px;
  color: var(--color-text);
}

.password-page__reveal {
  text-align: left;
  border-top: 1px solid #eceff1;
  padding-top: 20px;
}

.password-page__reveal-toggle {
  text-align: center;
  cursor: pointer;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-secondary);
  list-style: none;
}

.password-page__reveal-toggle::-webkit-details-marker {
  display: none;
}

.password-page__form-wrap {
  margin-top: 16px;
  gap: 10px;
}

.password-page__input {
  width: 100%;
  max-width: 280px;
  padding: 12px 16px;
  border: 1px solid #eceff1;
  border-radius: var(--radius-m);
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--color-primary);
}

.password-page__error {
  color: #c0392b;
  font-size: 13px;
  margin: 0;
}

.password-page__submit {
  width: 100%;
  max-width: 280px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "class": "section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 100
    }
  ]
}
{% endschema %}
