{%- comment -%}
  About page mission block: a heading/description and up to 3 icon features
  (icon is an optional image, and nothing renders when it is not set). The pull-quote that used to open this section now lives in its own
  "About quote" section, so the stats row can sit directly beneath it.
{%- endcomment -%}

<section
  id="mission"
  class="about-mission section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    {% render 'section-header',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      text: section.settings.description
    %}

    {%- if section.blocks.size > 0 -%}
      <div class="u-grid about-mission__features">
        {%- for block in section.blocks -%}
          <div class="about-mission__feature" {{ block.shopify_attributes }}>
            {%- if block.settings.icon_image != blank -%}
              <span class="u-inline-flex u-items-center u-justify-center about-mission__feature-icon" aria-hidden="true">
                {{ block.settings.icon_image | image_url: width: 64 | image_tag: loading: 'lazy', widths: '32, 64', sizes: '32px', width: 32, height: 32, alt: '' }}
              </span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="about-mission__feature-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="about-mission__feature-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.about-mission__features {
  grid-template-columns: 1fr;
  gap: var(--space-3);
  max-width: 900px;
  margin: 0 auto;
}

@media screen and (min-width: 750px) {
  .about-mission__features {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
}

.about-mission__feature {
  text-align: center;
  padding: var(--space-6);
  border-radius: var(--radius-m);
  background: var(--color-surface);
  transform-origin: center;
  transition: transform 0.25s ease;
  backface-visibility: hidden;
}

.about-mission__feature:hover {
  transform: translateY(-5px);
}

.about-mission__feature-icon {
  width: 48px;
  height: 48px;
  font-size: 22px;
  border-radius: 50%;
  background: var(--color-background);
  margin-bottom: 14px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  margin-right: auto;
}

.about-mission__feature-icon img {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.about-mission__feature-heading {
  font-size: 16px;
  font-weight: 600;
  font-family: var(--font-accent);
  color: var(--color-primary);
  margin: 0 0 6px;
}

.about-mission__feature-text {
  font-size: 13px;
  line-height: 1.6;
  color: var(--color-text-muted);
  margin: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "About mission",
  "class": "section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Mission" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to Perform" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Every ingredient we use has been selected for one reason: clinical proof of efficacy. We work directly with dermatologists, biochemists, and researchers at leading institutions.</p><p>Our formulations are never diluted for cost, never padded with filler. Every concentration is set at the level shown to produce measurable results in peer-reviewed studies.</p>"
    },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Lab Tested" },
        { "type": "text", "id": "text", "label": "Text", "default": "Every product is checked for safety." }
      ]
    }
  ],
  "presets": [
    {
      "name": "About mission",
      "blocks": [
        { "type": "feature", "settings": { "heading": "Lab Tested", "text": "Every product is checked for safety." } },
        { "type": "feature", "settings": { "heading": "High Potency", "text": "We use strong, active ingredients that actually work." } },
        { "type": "feature", "settings": { "heading": "Cruelty Free", "text": "100% natural extracts. No animal testing." } }
      ]
    }
  ]
}
{% endschema %}
