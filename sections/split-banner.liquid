<section
  class="split-banner section-padding{% if section.settings.width == 'container' %} container{% endif %}{% if section.settings.layout == 'image_right' %} split-banner--reverse{% endif %}{% if section.settings.image_2 %} split-banner--triptych{% endif %}"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="split-banner__media">
    {%- if section.settings.image -%}
      {%- assign media_h = 1400 | divided_by: section.settings.image.aspect_ratio | round -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 50vw, 100vw', width: 1400, height: media_h, alt: section.settings.image.alt | default: section.settings.heading }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <div class="split-banner__content{% if section.settings.style == 'light' %} split-banner__content--light{% endif %}">
    <h2 class="split-banner__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}
      <p class="split-banner__text" style="font-weight:600;margin-bottom:16px;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="split-banner__text">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: routes.root_url }}" class="button button--light">
        {{ section.settings.button_label }}
        {%- if section.settings.heading != blank -%}
          <span class="visually-hidden"> &ndash; {{ section.settings.heading }}</span>
        {%- endif -%}
      </a>
    {%- endif -%}
  </div>
  {%- if section.settings.image_2 -%}
    <div class="split-banner__media">
      {%- assign media_2_h = 1400 | divided_by: section.settings.image_2.aspect_ratio | round -%}
      {{ section.settings.image_2 | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(min-width: 750px) 33vw, 100vw', width: 1400, height: media_2_h, alt: section.settings.image_2.alt | default: section.settings.heading }}
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.split-banner {
  display: grid;
  grid-template-columns: 1fr;
}

@media screen and (min-width: 750px) {
  .split-banner {
    grid-template-columns: 1fr 1fr;
  }
  .split-banner--reverse {
    direction: rtl;
  }
  .split-banner--reverse > * {
    direction: ltr;
  }
  .split-banner--triptych {
    grid-template-columns: 1fr;
  }
}

@media screen and (min-width: 1200px) {
  .split-banner--triptych {
    grid-template-columns: 1fr 1fr 1fr;
  }
}

.split-banner__media {
  min-height: 320px;
  background-size: cover;
  background-position: center;
}

.split-banner__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  min-height: 320px;
}

.split-banner__content {
  background: var(--color-secondary);
  color: #fff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 48px 7em;
}

.split-banner__content.split-banner__content--light {
  background: #fff;
  color: var(--color-text);
}

.split-banner--triptych .split-banner__content {
  padding: 40px 32px;
}

.split-banner__title {
  font-family: var(--font-heading);
  margin: 0 0 20px;
  font-weight: 500;
  line-height: 1.2;
  font-size: clamp(28px, 22.88px + 1.37vw, 42px);
}

section.split-banner .button {
  align-self: center;
  padding: 14px 32px;
}

.split-banner__text {
  font-size: 15px;
  line-height: 1.7;
  margin: 0 0 28px;
  max-width: 480px;
}

.split-banner--triptych .split-banner__text {
  font-size: 14px;
  margin: 0 0 20px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "select",
      "id": "width",
      "label": "Section width",
      "options": [
        { "value": "full_width", "label": "Full width" },
        { "value": "container", "label": "Container" }
      ],
      "default": "full_width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        { "value": "image_left", "label": "Image left" },
        { "value": "image_right", "label": "Image right" }
      ],
      "default": "image_left"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Content style",
      "options": [
        { "value": "accent", "label": "Accent (teal)" },
        { "value": "light", "label": "Light" }
      ],
      "default": "accent"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Second image (optional)",
      "info": "When set, renders a 3-column layout: image / content / second image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Men Deserve Healthy Skin"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading (optional bold line)"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Skincare isn't just for women. Nourish, protect, and refresh your skin with simple daily care made for men.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
