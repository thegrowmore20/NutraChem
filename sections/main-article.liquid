{%- comment -%}
  Single blog article page. Inspired by Dawn's main-article.liquid (featured
  image, title/meta, content, comments, share) but rebuilt on this theme's own
  conventions: .container/.section-padding, plain-string schema names, and
  top-level checkbox settings instead of Dawn's block-based structure. The
  share button reuses the same generic <share-button> custom element markup
  as sections/main-product.liquid (duplicated here, self-contained, per this
  theme's rule that section JS stays scoped to its own section).
{%- endcomment -%}

<article
  class="article-template section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container container--narrow">
    <nav class="article-template__breadcrumb" aria-label="breadcrumb">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li aria-current="page">{{ article.title }}</li>
      </ol>
    </nav>

    <header class="article-template__header">
      <h1 class="article-template__title h1">{{ article.title }}</h1>
      {%- if section.settings.show_date or section.settings.show_author -%}
        <p class="article-template__meta">
          {%- if section.settings.show_date -%}<span>{{ article.published_at | date: '%B %d, %Y' }}</span>{%- endif -%}
          {%- if section.settings.show_date and section.settings.show_author -%}<span aria-hidden="true">&middot;</span>{%- endif -%}
          {%- if section.settings.show_author -%}<span>{{ article.author }}</span>{%- endif -%}
        </p>
      {%- endif -%}
    </header>

    {%- if section.settings.show_featured_image and article.image -%}
      <div class="article-template__hero">
        {{
          article.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '750, 1100, 1400, 1800',
            sizes: '(min-width: 990px) 800px, 100vw',
            width: 1400,
            height: 700,
            alt: article.image.alt | default: article.title
        }}
      </div>
    {%- endif -%}

    {%- if section.settings.show_excerpt and article.excerpt != blank -%}
      <p class="article-template__excerpt">{{ article.excerpt }}</p>
    {%- endif -%}

    <div class="article-template__content rte">
      {{ article.content }}
    </div>

    {%- if section.settings.show_share -%}
      <share-button
        class="article-template__share"
        data-share-url="{{ request.origin }}{{ article.url }}"
        data-share-title="{{ article.title | escape }}"
      >
        <button type="button" class="article-template__share-button" data-share-button>
          {% render 'icon', name: 'share' %}
          <span>{{ 'blogs.article.share' | t }}</span>
        </button>      
      </share-button>
    {%- endif -%}

    <div class="article-template__back">
      <a href="{{ blog.url }}" class="article-template__back-link">
        {% render 'icon', name: 'arrow-right' %}
        {{ 'blogs.article.back_to_blog' | t: title: blog.title }}
      </a>
    </div>

    {%- if section.settings.show_comments and blog.comments_enabled? -%}
      <div class="article-template__comments-section" id="comments">
        {%- if article.comments_count > 0 -%}
          <h2 class="article-template__comments-heading h3">{{ 'blogs.article.comments' | t: count: article.comments_count }}</h2>
          {%- paginate article.comments by 5 -%}
            <div class="article-template__comments-list">
              {%- for comment in article.comments -%}
                <article class="article-template__comment" id="{{ comment.id }}">
                  <div class="article-template__comment-body">{{ comment.content }}</div>
                  <p class="article-template__comment-meta">
                    <span>{{ comment.author }}</span>
                    <span aria-hidden="true">&middot;</span>
                    <span>{{ comment.created_at | date: '%B %d, %Y' }}</span>
                  </p>
                </article>
              {%- endfor -%}
            </div>
            {%- if paginate.pages > 1 -%}
              <nav class="pagination" aria-label="pagination">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}#comments" class="pagination__link pagination__link--prev" aria-label="{{ 'collections.general.pagination_previous' | t }}">{% render 'icon', name: 'chevron-right' %}</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}#comments" class="pagination__link">{{ part.title }}</a>
                  {%- else -%}
                    <span class="pagination__link{% if part.title == paginate.current_page %} pagination__link--current{% endif %}" {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}#comments" class="pagination__link" aria-label="{{ 'collections.general.pagination_next' | t }}">{% render 'icon', name: 'chevron-right' %}</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endpaginate -%}
        {%- endif -%}

        {%- form 'new_comment', article, class: 'article-template__comment-form' -%}
          <h2 class="article-template__comment-form-heading h3">{{ 'blogs.article.comment_form_title' | t }}</h2>

          {%- if form.posted_successfully? -%}
            <p class="article-template__comment-success" role="status">
              {%- if blog.moderated? -%}
                {{ 'blogs.article.success_moderated' | t }}
              {%- else -%}
                {{ 'blogs.article.success' | t }}
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="article-template__comment-error" role="alert">
              <p>{{ 'sections.contact.form.error_heading' | t }}</p>
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="article-template__comment-row">
            <div class="article-template__comment-field">
              <label for="CommentForm-author">{{ 'blogs.article.name' | t }}</label>
              <input type="text" id="CommentForm-author" name="comment[author]" autocomplete="name" required value="{{ form.author }}">
            </div>
            <div class="article-template__comment-field">
              <label for="CommentForm-email">{{ 'blogs.article.email' | t }}</label>
              <input type="email" id="CommentForm-email" name="comment[email]" autocomplete="email" required value="{{ form.email }}">
            </div>
          </div>
          <div class="article-template__comment-field">
            <label for="CommentForm-body">{{ 'blogs.article.message' | t }}</label>
            <textarea id="CommentForm-body" name="comment[body]" rows="4" required>{{ form.body }}</textarea>
          </div>

          {%- if blog.moderated? -%}
            <p class="article-template__comment-notice">{{ 'blogs.article.moderated' | t }}</p>
          {%- endif -%}

          <button type="submit" class="button button--dark">{{ 'blogs.article.post' | t }}</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% stylesheet %}
.container--narrow {
  max-width: 800px;
}

.article-template__breadcrumb ol {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  padding: 0 0 15px;
  font-size: 14px;
  color: #55636b;
  list-style: none;
}

.article-template__breadcrumb li {
  display: flex;
  align-items: center;
  gap: 6px;
}

.article-template__breadcrumb li:not(:last-child)::after {
  content: '/';
  color: #55636b;
}

.article-template__breadcrumb a {
  color: #55636b;
}

.article-template__breadcrumb a:hover {
  color: var(--color-secondary);
}

.article-template__breadcrumb li[aria-current='page'] {
  color: var(--color-primary);
}

.article-template__header {
  text-align: center;
  margin-bottom: 28px;
}

.article-template__title {
  color: var(--color-primary);
  margin: 0 0 12px;
}

.article-template__meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  font-size: 13px;
  color: #7c8a90;
  margin: 0;
}

.article-template__hero {
  border-radius: var(--radius-m);
  overflow: hidden;
  margin-bottom: 28px;
}

.article-template__hero img {
  width: 100%;
  height: auto;
  display: block;
}

.article-template__excerpt {
  font-size: 18px;
  line-height: 1.6;
  color: var(--color-primary);
  font-weight: 500;
  margin: 0 0 24px;
}

.article-template__content {
  font-size: 15px;
  line-height: 1.75;
  color: var(--color-text);
}

.article-template__content :is(h2, h3, h4) {
  color: var(--color-primary);
  margin: 32px 0 14px;
}

.article-template__content p {
  margin: 0 0 18px;
}

.article-template__content img {
  max-width: 100%;
  height: auto;
  border-radius: var(--radius-m);
}

.article-template__content a {
  color: var(--color-secondary);
  text-decoration: underline;
}

.article-template__share {
  display: block;
  margin-top: 32px;
}

.article-template__share-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  height: 40px;
  padding: 0 18px;
  border: 1px solid #eceff1;
  border-radius: var(--radius-m);
  background: none;
  color: var(--color-primary);
  font-family: var(--font-body);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
}

.article-template__back {
  margin-top: 24px;
  padding-top: 24px;
  border-top: 1px solid #eceff1;
}

.article-template__back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--color-primary);
  font-size: 14px;
  font-weight: 600;
}

.article-template__back-link svg {
  transform: scaleX(-1);
}

.article-template__back-link:hover {
  color: var(--color-secondary);
}

.article-template__comments-section {
  margin-top: 48px;
  padding-top: 40px;
  border-top: 1px solid #eceff1;
}

.article-template__comments-heading,
.article-template__comment-form-heading {
  color: var(--color-primary);
  margin: 0 0 20px;
}

.article-template__comments-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 32px;
}

.article-template__comment {
  padding: 18px 20px;
  background: var(--color-surface);
  border-radius: var(--radius-m);
}

.article-template__comment-body {
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text);
}

.article-template__comment-body p {
  margin: 0;
}

.article-template__comment-meta {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #7c8a90;
  margin: 10px 0 0;
}

.article-template__comment-form-heading {
  margin-top: 8px;
}

.article-template__comment-success {
  color: #1e7e34;
  font-size: 14px;
  font-weight: 600;
  margin: 0 0 16px;
}

.article-template__comment-error {
  color: #c0392b;
  font-size: 13px;
  margin: 0 0 16px;
  background: #fdecea;
  border: 1px solid #f3c6c1;
  border-radius: var(--radius-s);
  padding: 10px 14px;
}

.article-template__comment-error p {
  margin: 0 0 4px;
  font-weight: 600;
}

.article-template__comment-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

@media screen and (max-width: 479px) {
  .article-template__comment-row {
    grid-template-columns: 1fr;
  }
}

.article-template__comment-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.article-template__comment-field label {
  font-size: 13px;
  font-weight: 500;
  color: var(--color-primary);
}

.article-template__comment-field input,
.article-template__comment-field textarea {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #eceff1;
  border-radius: var(--radius-s);
  font-family: var(--font-body);
  font-size: 15px;
  color: var(--color-primary);
  background: var(--color-background);
}

.article-template__comment-field input:focus,
.article-template__comment-field textarea:focus {
  outline: none;
  border-color: var(--color-secondary);
}

.article-template__comment-field textarea {
  resize: vertical;
  min-height: 100px;
}

.article-template__comment-notice {
  font-size: 13px;
  color: #7c8a90;
  margin: 0 0 16px;
}

.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 32px;
}

.pagination__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 36px;
  height: 36px;
  padding: 0 6px;
  border-radius: var(--radius-s);
  color: var(--color-primary);
  font-size: 13px;
}

.pagination__link--current {
  background: var(--color-secondary);
  color: #fff;
}

.pagination__link--prev svg {
  transform: scaleX(-1);
}
{% endstylesheet %}

{% javascript %}
class ShareButton extends HTMLElement {
  constructor() {
    super()
    const button = this.querySelector('[data-share-button]')
    if (!button) return
    button.addEventListener('click', () => this.#onShare())
  }

  async #onShare() {
    const url = this.dataset.shareUrl
    const title = this.dataset.shareTitle
    if (navigator.share) {
      try {
        await navigator.share({ title, url })
      } catch (error) {
        /* user dismissed the native share sheet */
      }
      return
    }
    try {
      await navigator.clipboard.writeText(url)
      const copied = this.querySelector('[data-share-copied]')
      if (copied) {
        copied.hidden = false
        window.setTimeout(() => {
          copied.hidden = true
        }, 2000)
      }
    } catch (error) {
      /* clipboard unavailable; no further fallback */
    }
  }
}

if (!customElements.get('share-button')) {
  customElements.define('share-button', ShareButton)
}
{% endjavascript %}

{% schema %}
{
  "name": "Article",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_featured_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comments",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_share",
      "label": "Show share button",
      "default": true
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ]
}
{% endschema %}
