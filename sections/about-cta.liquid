{%- comment -%}
  About page closing CTA: eyebrow + heading + description + two buttons +
  a row of small icon/label trust badges.
{%- endcomment -%}

<section
  class="about-cta section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="about-cta__inner">
      {% render 'section-header',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        text: section.settings.description
      %}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="u-flex u-items-center u-justify-center about-cta__actions">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="button button--accent">{{ section.settings.button_1_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank and section.settings.button_2_link != blank -%}
            <a href="{{ section.settings.button_2_link }}" class="button button--light">{{ section.settings.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="u-flex u-items-center u-justify-center about-cta__badges">
          {%- for block in section.blocks -%}
            <span class="u-inline-flex u-items-center about-cta__badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon_image != blank -%}
                <span class="about-cta__badge-icon" aria-hidden="true">
                  {{ block.settings.icon_image | image_url: width: 48 | image_tag: loading: 'lazy', widths: '24, 48', sizes: '24px', width: 24, height: 24, alt: '' }}
                </span>
              {%- endif -%}
              {{ block.settings.label }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.about-cta {
  background: var(--color-surface);
}

.about-cta__inner {
  text-align: center;
  max-width: 640px;
  margin: 0 auto;
}

.about-cta__actions {
  gap: var(--space-4);
  flex-wrap: wrap;
  margin-top: var(--space-7);
}

.about-cta__badges {
  flex-wrap: wrap;
  gap: 10px var(--space-6);  
  padding-top: var(--space-7);
  border-top: 1px solid var(--color-border);
}

.about-cta__badge {
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  font-family: var(--font-subheading);
  color: var(--color-primary);
}

.about-cta__badge-icon {
  display: inline-flex;
}

.about-cta__badge-icon img {
  display: block;
  width: 24px;
  height: 24px;
  object-fit: contain;
}
{% endstylesheet %}

{% schema %}
{
  "name": "About CTA",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready to Experience the Difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Skin Deserves Real Science" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Browse our full collection and find your perfect formula. Every product ships with our Glow Guarantee, see real results or your money back.</p>"
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop All Products" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image" },
        { "type": "text", "id": "label", "label": "Label", "default": "Free Shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About CTA",
      "blocks": [
        { "type": "badge", "settings": { "label": "Free Shipping" } },
        { "type": "badge", "settings": { "label": "Glow Guarantee" } },
        { "type": "badge", "settings": { "label": "Clinically Proven" } },
        { "type": "badge", "settings": { "label": "Vegan & Cruelty-Free" } }
      ]
    }
  ]
}
{% endschema %}
