{%- comment -%}
  About page closing CTA: eyebrow + heading + description + two buttons +
  a row of small icon/label trust badges.
{%- endcomment -%}

<section
  class="about-cta section-padding"
  style="--padding-top: {{ section.settings.padding_top }}px; --padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="container">
    <div class="about-cta__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="about-cta__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="about-cta__heading h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="about-cta__description">{{ section.settings.description }}</div>
      {%- endif -%}

      {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
        <div class="about-cta__actions">
          {%- if section.settings.button_1_label != blank -%}
            <a href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}" class="button button--accent">{{ section.settings.button_1_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a href="{{ section.settings.button_2_link | default: '#' }}" class="button button--light">{{ section.settings.button_2_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="about-cta__badges">
          {%- for block in section.blocks -%}
            <span class="about-cta__badge" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}<span aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
              {{ block.settings.label }}
            </span>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.about-cta {
  background: var(--color-surface);
}

.about-cta__inner {
  text-align: center;
  max-width: 640px;
  margin: 0 auto;
}

.about-cta__eyebrow {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-secondary);
  margin: 0 0 12px;
}

.about-cta__heading {
  color: var(--color-primary);
  margin: 0 0 16px;
}

.about-cta__description {
  font-size: 15px;
  line-height: 1.7;
  color: var(--color-text);
  margin: 0;
}

.about-cta__actions {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 28px;
}

.about-cta__badges {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 10px 24px;
  margin-top: 32px;
  padding-top: 28px;
  border-top: 1px solid #e2e8ea;
}

.about-cta__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-primary);
}
{% endstylesheet %}

{% schema %}
{
  "name": "About CTA",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ready to Experience the Difference" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Skin Deserves Real Science" },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Browse our full collection and find your perfect formula. Every product ships with our Glow Guarantee, see real results or your money back.</p>"
    },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop All Products" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🚚" },
        { "type": "text", "id": "label", "label": "Label", "default": "Free Shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "About CTA",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🚚", "label": "Free Shipping" } },
        { "type": "badge", "settings": { "icon": "↩️", "label": "Glow Guarantee" } },
        { "type": "badge", "settings": { "icon": "🔬", "label": "Clinically Proven" } },
        { "type": "badge", "settings": { "icon": "🌿", "label": "Vegan & Cruelty-Free" } }
      ]
    }
  ]
}
{% endschema %}
