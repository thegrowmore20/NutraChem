{%- comment -%}
  Compact product card used inside the desktop mega-menu dropdown.
  Deliberately separate from snippets/product-card.liquid: this is a strict
  subset (image, one-line title, 14px reviews — no price, no add-to-cart),
  so it gets its own contract instead of bolting flags onto the grid card.
  Accepts: product
{%- endcomment -%}
<a href="{{ product.url }}" class="mega-menu-card">
  <span class="mega-menu-card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', widths: '200, 300, 400', sizes: '200px', width: 200, height: 200, alt: product.title }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
  </span>
  <span class="mega-menu-card__title">{{ product.title }}</span>
  {%- if product.metafields.air_reviews_product.review_count > 0 -%}
    {%- assign menu_card_rating = product.metafields.air_reviews_product.review_avg | plus: 0 -%}
    <span class="u-flex u-items-center mega-menu-card__rating">
      {% render 'star-rating', rating: menu_card_rating %}
      <span>{{ menu_card_rating }} ({{ product.metafields.air_reviews_product.review_count }})</span>
    </span>
  {%- endif -%}
</a>
