{% doc %}
  Renders Product JSON-LD with variant offers and verified review metafields.

  @param {product} product - The product displayed on the page.

  @example
  {% render 'product-schema', product: product %}
{% enddoc %}

{%- if product != blank -%}
  {%- liquid
    assign schema_variant = product.selected_or_first_available_variant
    assign schema_rating = product.metafields.reviews.rating.value
    assign schema_rating_value = schema_rating.rating | default: 0 | plus: 0
    assign schema_review_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0
    assign schema_rating_min = schema_rating.scale_min | default: 1 | plus: 0
    assign schema_rating_max = schema_rating.scale_max | default: 5 | plus: 0
    assign schema_has_rating = false
    if schema_review_count > 0
      if schema_rating != blank
        if schema_rating_value >= schema_rating_min and schema_rating_value <= schema_rating_max
          assign schema_has_rating = true
        endif
      endif
    endif
  -%}
  {%- capture product_schema_json -%}
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 5000 | json }},
      "url": {{ request.origin | append: product.url | json }},
      "image": [
        {%- for schema_image in product.images limit: 5 -%}
          {%- assign schema_image_url = schema_image | image_url: width: 1024 -%}
          {%- assign schema_image_prefix = schema_image_url | slice: 0, 2 -%}
          {%- if schema_image_prefix == '//' -%}
            {%- assign schema_image_url = schema_image_url | prepend: 'https:' -%}
          {%- endif -%}
          {{ schema_image_url | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "brand": {
        "@type": "Brand",
        "name": {{ shop.name | json }}
      },
      "sku": {{ schema_variant.sku | default: product.id | append: '' | json }},
      "offers": {% if product.variants.size > 1 %}[{% endif %}
        {%- for schema_offer in product.variants -%}
          {
            "@type": "Offer",
            {% if product.variants.size > 1 %}
              "name": {{ schema_offer.title | json }},
            {% endif %}
            "url": {{ request.origin | append: schema_offer.url | json }},
            "sku": {{ schema_offer.sku | default: schema_offer.id | append: '' | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ schema_offer.price | divided_by: 100.0 | json }},
            "availability": "https://schema.org/{% if schema_offer.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition",
            "seller": {
              "@type": "Organization",
              "name": {{ shop.name | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      {% if product.variants.size > 1 %}]{% endif %},
      "productID": {{ product.id | append: '' | json }}
      {%- if schema_has_rating -%},
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": {{ schema_rating_value | json }},
          "reviewCount": {{ schema_review_count | json }},
          "bestRating": {{ schema_rating_max | json }},
          "worstRating": {{ schema_rating_min | json }}
        }
      {%- endif -%}
      {%- if product.type != blank -%},
        "category": {{ product.type | json }}
      {%- endif -%}
      {%- if product.vendor != blank -%},
        "manufacturer": {
          "@type": "Organization",
          "name": {{ product.vendor | json }}
        }
      {%- endif -%}
      {%- if schema_variant.weight > 0 -%},
        "weight": {
          "@type": "QuantitativeValue",
          "value": {{ schema_variant.weight | json }},
          "unitCode": "GRM"
        }
      {%- endif -%}
    }
  {%- endcapture -%}
  <script type="application/ld+json">
    {{ product_schema_json | replace: '<', '\u003c' }}
  </script>
{%- endif -%}
